;;; bench-sessions.el --- how much UI-thread time the session list takes  -*- lexical-binding: t; -*-

;; Run against any checkout of the harness:
;;   BENCH_ROOT=/path/to/checkout BENCH_SHOWN=0 BENCH_SECONDS=30 \
;;     emacs -Q --batch -l scripts/analysis/bench-sessions.el
;; BENCH_N sessions (default 942), BENCH_RATE session updates a second,
;; BENCH_LIVE token ticks a second, BENCH_INTERNAL internal-session
;; records made and deleted a second (the harness's own model calls).
;; BENCH_SHOWN=1 shows the list in a window, 0 leaves it in none.

(defconst bench-root (file-name-as-directory (or (getenv "BENCH_ROOT") default-directory)))
(dolist (dir '("lisp" "lisp/modules" "lisp/ui" "lisp/vendor/worktree-assume" "lisp/vendor/change-review" "lisp/vendor/compose-quote"))
  (add-to-list 'load-path (expand-file-name dir bench-root)))
(add-to-list 'load-path bench-root)

(require 'cl-lib)
(require 'harness-ui)
(require 'harness-ui-sessions)

(defun bench--env (name default)
  (let ((v (getenv name))) (if (and v (not (string-empty-p v))) (string-to-number v) default)))

(defconst bench-n (bench--env "BENCH_N" 942))
(defconst bench-shown (= 1 (bench--env "BENCH_SHOWN" 1)))
(defconst bench-seconds (bench--env "BENCH_SECONDS" 30))
(defconst bench-rate (bench--env "BENCH_RATE" 6))
(defconst bench-live (bench--env "BENCH_LIVE" 15))
(defconst bench-internal (bench--env "BENCH_INTERNAL" 3))
(defconst bench-projects 40)

(defvar bench-ids nil)
(defvar bench-running nil)

(defun bench--session (i)
  (let* ((id (format "s-%04d" i))
         (project (format "/work/repo/.worktrees/task-%02d/" (% (/ i 3) bench-projects)))
         (running (zerop (% i 12))))
    (list :id id :name (format "Session number %d about the thing" i) :project project :cwd project
          :status (if running "running" (if (zerop (% i 7)) "inactive" "idle"))
          :kind (if (zerop (% i 3)) "main" "fork")
          :parent-id (and (> (% i 3) 0) (format "s-%04d" (1- i)))
          :model (if (zerop (% i 2)) "claude:sonnet" "claude:opus")
          :permission-mode "auto" :thinking (and (zerop (% i 5)) "high")
          :context-window 200000 :created (+ 1000.0 i) :updated (+ 1000.0 i)
          :last-message (+ 1000.0 i)
          :usage (list :cost (* 0.37 (% i 11)) :input (* 1000 i) :output (* 90 i)
                       :context (* 100 (% i 1500)) :last-output 50
                       :stream-output (* 80 i) :stream-seconds (+ 3.0 (% i 90))
                       :billing "subscription" :plan "max"))))

(defun bench--populate ()
  (clrhash harness-ui--sessions)
  (clrhash harness-ui--live)
  (setq bench-ids nil bench-running nil)
  (dotimes (i bench-n)
    (let ((s (bench--session i)))
      (puthash (plist-get s :id) s harness-ui--sessions)
      (push (plist-get s :id) bench-ids)
      (when (equal (plist-get s :status) "running")
        (push (plist-get s :id) bench-running)
        (puthash (plist-get s :id) (list :context (+ 5000 i) :output (* 20 i) :estimated 100)
                 harness-ui--live)))))

(defun bench--counts () (memory-use-counts))

(defun bench--redraw-cost ()
  "Return plist: seconds, conses, strings, string bytes and GCs of a redraw."
  (harness-ui-sessions--redraw)             ; warm up
  (garbage-collect)
  (let* ((n 5)
         (c0 (bench--counts)) (g0 gcs-done) (ge0 gc-elapsed) (t0 (float-time)))
    (dotimes (_ n) (harness-ui-sessions--redraw))
    (let ((c1 (bench--counts)) (took (- (float-time) t0)))
      (list :seconds (/ took n)
            :conses (/ (- (nth 0 c1) (nth 0 c0)) n)
            :string-chars (/ (- (nth 4 c1) (nth 4 c0)) n)
            :strings (/ (- (nth 6 c1) (nth 6 c0)) n)
            :intervals (/ (- (nth 5 c1) (nth 5 c0)) n)
            :gcs (/ (float (- gcs-done g0)) n)
            :gc-seconds (/ (- gc-elapsed ge0) n)))))

(defun bench--churn ()
  "Run BENCH_SECONDS of session churn; return stall and CPU figures."
  (let* ((beat 0.05)
         (last (float-time)) (stalls nil) (events 0)
         (redraws 0)
         (start (float-time)) (cpu0 (float-time (get-internal-run-time)))
         (g0 gcs-done) (ge0 gc-elapsed)
         (deadline (+ start bench-seconds))
         (sessions (vconcat bench-ids)) (running (vconcat bench-running))
         (internal-n 0))
    (advice-add 'harness-ui-sessions--redraw :before (lambda () (cl-incf redraws))
                '((name . bench-count)))
    (let ((heart (run-at-time beat beat
                              (lambda ()
                                (let* ((now (float-time)) (late (- now last beat)))
                                  (when (> late 0.02) (push late stalls))
                                  (setq last now)))))
          (poisson nil))
      (cl-flet ((arm (rate fn)
                  (when (> rate 0)
                    (let (self)
                      (setq self (lambda ()
                                   (funcall fn)
                                   (push (run-at-time (- (/ (log (- 1.0 (/ (random 1000000) 1000000.0)))
                                                            rate))
                                                      nil self)
                                         poisson)))
                      (push (run-at-time (/ 1.0 rate) nil self) poisson)))))
        (arm bench-rate
             (lambda ()
               (cl-incf events)
               (let* ((id (aref sessions (random (length sessions))))
                      (s (copy-sequence (harness-ui-session id))))
                 (setq s (plist-put s :updated (float-time)))
                 (harness-ui-cache-session s))))
        (arm bench-live
             (lambda ()
               (cl-incf events)
               (when (> (length running) 0)
                 (harness-ui--store-live (aref running (random (length running)))
                                         (list :context (+ 5000 (random 90000)) :output (random 9000)
                                               :estimated (random 300))))))
        (arm bench-internal
             (lambda ()
               (cl-incf events)
               (let ((id (format "internal-%d" (cl-incf internal-n))))
                 (harness-ui-cache-session (list :id id :name nil :kind "internal" :status "running"
                                                 :project "/work/repo/" :updated (float-time)))
                 (run-at-time 0.3 nil (lambda () (harness-ui--forget-session id)))))))
      (while (< (float-time) deadline)
        (accept-process-output nil 0.01))
      (cancel-timer heart)
      (mapc #'cancel-timer poisson))
    (advice-remove 'harness-ui-sessions--redraw 'bench-count)
    (harness-ui-sessions--drop-pending-redraws)
    (let* ((wall (- (float-time) start))
           (cpu (- (float-time (get-internal-run-time)) cpu0)))
      (list :wall wall :cpu-busy (/ cpu wall) :events events :redraws redraws
            :stalls-over-20ms (length stalls) :longest-stall (if stalls (apply #'max stalls) 0.0)
            :time-stalled (apply #'+ stalls)
            :gcs (- gcs-done g0) :gc-seconds (- gc-elapsed ge0)))))

(defun bench--profile ()
  "Profile 30 redraws; print the functions with the most samples, stack-wide and on top."
  (require 'profiler)
  (setq profiler-sampling-interval 200000)
  (harness-ui-sessions--redraw)
  (let ((kind (if (= 1 (bench--env "BENCH_MEM" 0)) 'mem 'cpu)))
    (profiler-start kind)
    (dotimes (_ 30) (harness-ui-sessions--redraw))
    (profiler-stop)
    (setq profiler-cpu-log (if (eq kind 'mem) profiler-memory-log profiler-cpu-log)))
  (let ((incl (make-hash-table :test 'equal)) (self (make-hash-table :test 'equal)) (total 0))
    (maphash (lambda (stack count)
               (let ((seen nil) (first t))
                 (cl-incf total count)
                 (mapc (lambda (f)
                         (let ((n (if (symbolp f) (symbol-name f) (format "%.50S" f))))
                           (when first (puthash n (+ count (gethash n self 0)) self) (setq first nil))
                           (unless (member n seen)
                             (push n seen)
                             (puthash n (+ count (gethash n incl 0)) incl))))
                       (append stack nil))))
             profiler-cpu-log)
    (cl-flet ((top (table n)
                (let (r) (maphash (lambda (k v) (push (cons k v) r)) table)
                     (mapcar (lambda (c) (format "%5.1f%% %s" (* 100.0 (/ (cdr c) (float total))) (car c)))
                             (seq-take (sort r (lambda (a b) (> (cdr a) (cdr b)))) n)))))
      (princ (format "profile: %d samples\n  inclusive:\n    %s\n  self:\n    %s\n" total
                     (string-join (top incl 38) "\n    ") (string-join (top self 20) "\n    "))))))

(defun bench-main ()
  (cl-letf (((symbol-function 'harness-ui-refresh-sessions)
             (lambda (&optional cb) (when cb (funcall cb nil))))
            ((symbol-function 'harness-ui-request)
             (lambda (&rest _) (harness-resolved nil)))
            ((symbol-function 'harness-ui-display-view)
             (lambda (buffer &rest _) (set-window-buffer (selected-window) buffer))))
    (let ((harness-ui-event-functions nil) (harness-ui-redraw-hook nil)
          (harness-ui-sessions-changed-hook nil) (harness-ui-pending-changed-hook nil)
          (harness-ui-rate-functions nil) (harness-ui-live-functions nil))
      (bench--populate)
      (harness-ui-sessions--init)
      (let ((default-directory "/"))
        (harness-sessions t))
      (let ((entries (with-current-buffer harness-ui-sessions--buffer-name (length tabulated-list-entries))))
        (princ (format "root=%s sessions=%d rows=%d shown=%s\n" bench-root bench-n entries bench-shown)))
      (princ (format "one redraw: %S\n" (bench--redraw-cost)))
      (when (= 1 (bench--env "BENCH_PROFILE" 0)) (bench--profile))
      (unless bench-shown
        (dolist (w (get-buffer-window-list harness-ui-sessions--buffer-name nil t))
          (set-window-buffer w (get-buffer-create "*other*"))))
      (princ (format "churn %ds: %S\n" bench-seconds (bench--churn))))))

(bench-main)

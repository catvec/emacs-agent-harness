;;; bench-end-to-end.el --- What a client actually waits for  -*- lexical-binding: t; -*-
;;; Commentary:
;;
;; Every other bench in this directory is synthetic: it loads a handful of
;; modules into a batch Emacs and times a function.  That measured the wrong
;; thing.  A previous bench loaded 7 of the tree's 170 modules, with no ACP
;; client connected, and reported 40 streaming sessions at 3% CPU while the
;; live harness took minutes per message.
;;
;; This one measures what a user waits for, on the production path:
;;
;;   1. a real `emacs --batch' harness server, started exactly as
;;      `harness-server-main' starts one (HARNESS_SERVER_CONFIG/TOKEN),
;;      loading its full module set from lisp/modules;
;;   2. a real ACP client over TCP, the same code path the Emacs UI and the
;;      Flutter client use (`harness-acp-connect' + `harness-acp-initialize');
;;   3. real turns, driven through `session/prompt' and the demo provider, so
;;      the deltas are streamed, persisted, indexed and fanned out for real.
;;
;; The numbers it reports are the ones a user feels:
;;
;;   connect      socket open -> initialize -> session/list
;;   reconnect    the same again on a fresh socket (what a phone waking does)
;;   prompt       session/prompt sent -> first delta -> last delta -> turn end
;;   stutter      heartbeat lateness in the CLIENT, while N sessions stream
;;
;; It refuses to report a number it cannot justify: before measuring it
;; asserts that the server loaded its full module set, that a client is
;; connected, and that the transcript is on disk.  A run that cannot prove
;; those is an error, not a fast result.
;;
;; Run it with scripts/analysis/bench-end-to-end.sh.
;;; Code:

(require 'cl-lib)
(require 'json)
;; The client half: the same ACP code the Emacs UI and Flutter use.
(require 'harness-core)
(require 'harness-acp)

(defvar bench-e2e-root
  (file-name-as-directory
   (or (getenv "BENCH_ROOT")
       (expand-file-name "../.." (file-name-directory
                                  (or load-file-name buffer-file-name))))))

(defvar bench-e2e-state nil "State directory of the server under test.")
(defvar bench-e2e-levels '(1 4 12) "Concurrency levels to measure.")
(defvar bench-e2e-stream-seconds 15 "How long each level streams.")
(defvar bench-e2e--server nil)
(defvar bench-e2e--address nil)
(defvar bench-e2e--token nil)
(defvar bench-e2e--conn nil)
(defvar bench-e2e--notes nil "Notifications received from the server, newest first.")

;;;; The server

(defun bench-e2e-write-config (file)
  "Write the server's configuration FILE.
The same shape `harness-server-spawn' writes: state directory, module
directories, every module enabled, and the demo provider so turns can
be driven with no network."
  (with-temp-file file
    (insert ";; generated by bench-end-to-end.el\n")
    (insert (format "(setq harness-state-directory %S)\n" bench-e2e-state))
    (insert (format "(setq harness-directory %S)\n" bench-e2e-root))
    (insert (format "(setq harness-module-directories '(%S))\n"
                    (expand-file-name "lisp/modules" bench-e2e-root)))
    (insert "(setq harness-enabled-modules t)\n")
    (insert "(setq harness-off-by-default-modules nil)\n")
    ;; The demo provider streams on a timer with no network, so a turn
    ;; exercises the real delta path without an API call.
    (insert "(setq harness-model \"demo:scripted\")\n")
    (insert "(setq harness-provider-demo--delay 0.02)\n")
    ;; Nobody is here to answer a permission prompt.
    (insert "(setq harness-permission-mode 'yolo)\n")
    (insert "(setq harness-latency-enabled t)\n")
    (insert "(setq harness-log-level 'warn)\n")
    ;; Keep the bench's own turn path clean of the unrelated search-index
    ;; crash on a fresh state directory (see the report).
    (insert "(setq harness-session-search-index nil)\n")))


(defun bench-e2e-server-command (config)
  "The command line that starts a harness server with CONFIG."
  (list (expand-file-name invocation-name invocation-directory)
        "-Q" "--batch"
        "-L" (expand-file-name "lisp" bench-e2e-root)
        "-L" (expand-file-name "lisp/modules" bench-e2e-root)
        "-L" bench-e2e-root
        "-l" "harness-server"
        "-f" "harness-server-main"))

(defun bench-e2e-server-environment (config token)
  "Return a `process-environment' naming CONFIG and TOKEN for the server.
The same shape `harness-server-spawn' binds: the child is told where its
configuration is and what secret to require, and nothing else."
  (append (list (concat "HARNESS_SERVER_CONFIG=" config)
                (concat "HARNESS_SERVER_TOKEN=" token)
                ;; The bench is the parent, as a UI's Emacs is: the server
                ;; exits when its parent goes, and that is worth keeping.
                (format "HARNESS_SERVER_PARENT=%d" (emacs-pid)))
          process-environment))

(defun bench-e2e-address-in-stderr ()
  "Return the address the server announced on stderr, or nil."
  (with-current-buffer " *bench-e2e-server-stderr*"
    (save-excursion
      (goto-char (point-min))
      (when (re-search-forward "^HARNESS-ACP-ADDRESS \\(.+\\)$" nil t)
        (string-trim (match-string 1))))))

(defvar bench-e2e-seed-sessions 0 "Sessions to seed before the server starts.")
(defvar bench-e2e-seed-nodes 200 "Nodes per seeded session.")
(defvar bench-e2e-seed-bytes 40000 "Bytes per seeded session's transcript.")

(defun bench-e2e-start-server ()
  "Start a real harness server; return its \"HOST:PORT\" address."
  (setq bench-e2e-state
        (file-name-as-directory (make-temp-file "harness-bench-e2e-" t)))
  (when (> bench-e2e-seed-sessions 0)
    (princ (format "seeding     %s\n"
                   (bench-e2e-seed-state bench-e2e-seed-sessions
                                            bench-e2e-seed-nodes
                                            bench-e2e-seed-bytes))))
  (let* ((config (expand-file-name "server-config.el" bench-e2e-state))
         ;; The secret goes out of band from parent to child, as
         ;; `harness-server-spawn' does it: the bench is the parent here.
         (token (secure-hash 'sha256 (format "bench-%s-%s"
                                             (float-time) (emacs-pid))))
         (default-directory bench-e2e-root))
    (bench-e2e-write-config config)
    (setq bench-e2e--token token)
    (setq bench-e2e--server
          (let ((process-environment (bench-e2e-server-environment config token)))
            (make-process :name "bench-e2e-server"
                          :buffer (get-buffer-create " *bench-e2e-server*")
                          :command (bench-e2e-server-command config)
                          :coding 'utf-8-unix
                          :noquery t
                          :stderr (get-buffer-create " *bench-e2e-server-stderr*"))))
    (let ((deadline (+ (float-time) 180))
          address)
      (while (and (not address) (< (float-time) deadline))
        (accept-process-output bench-e2e--server 0.05)
        (setq address (bench-e2e-address-in-stderr)))
      (unless address
        (error "Bench: server announced no address within 180s"))
      (setq bench-e2e--address address)
      address)))

(defun bench-e2e-stop-server ()
  (ignore-errors
    (when (process-live-p bench-e2e--server) (delete-process bench-e2e--server)))
  (ignore-errors (bench-e2e-disconnect)))

;;;; The client

(defun bench-e2e-on-notification (method params _respond)
  "Record one server message: METHOD, PARAMS, and when it arrived."
  (push (cons (float-time) (list :method method :params params))
        bench-e2e--notes))

(defun bench-e2e-connect ()
  "Open a real ACP client connection and initialize it.
Return a plist of what the handshake cost, in seconds."
  ;; A UI learns the token from the Emacs that spawned the server; the
  ;; bench generated it, so it already knows it.  It is set nil here so
  ;; `harness-acp-connect' does not race the still-connecting socket with
  ;; an authenticate; the bench sends that itself, and times it.
  (setq harness-acp-token nil)
  (let* ((t0 (float-time))
         (conn (harness-acp-connect bench-e2e--address))
         (t1 (float-time)))
    (setq bench-e2e--conn conn)
    (harness-acp-set-handler conn #'bench-e2e-on-notification)
    ;; initialize, over the wire, exactly as a UI does.
    (harness-await (harness-acp-initialize conn) 120)
    (let ((t2 (float-time)))
      ;; Authenticate over the wire and wait for it: until it lands the
      ;; server refuses every method but `initialize'.
      (let ((t3 (float-time)))
        (harness-await (harness-acp-authenticate conn bench-e2e--token) 120)
        (list :socket (- t1 t0)
              :initialize (- t2 t1)
              :authenticate (- t3 t2)
              :total (- t3 t0))))))

(defun bench-e2e-disconnect ()
  (when (and bench-e2e--conn (harness-acp-connection-p bench-e2e--conn))
    (ignore-errors (harness-acp-close bench-e2e--conn "bench"))
    (setq bench-e2e--conn nil)))

(defun bench-e2e-call (method params &optional timeout)
  "Call METHOD with PARAMS over the client; return (RESULT . SECONDS)."
  (let* ((t0 (float-time))
         (result (harness-await (harness-acp-request bench-e2e--conn method params)
                                (or timeout 180))))
    (cons result (- (float-time) t0))))

;;;; Seeding a realistic state

(defun bench-e2e-seed-state (n nodes-each bytes-each)
  "Write N session records of NODES-EACH nodes, about BYTES-EACH each.
A live harness is not an empty one: its transcripts are on disk and its
`session/list' has to answer for them, which a bench against a fresh
state directory never sees.  The files are written in the harness's own
format (`sessions/ID.json' and `sessions/ID.nodes.jsonl'), so the server
reads them exactly as it reads real ones."
  (let* ((dir (expand-file-name "sessions" bench-e2e-state))
         (text (make-string (max 1 (/ bytes-each (max 1 nodes-each))) ?x)))
    (make-directory dir t)
    (dotimes (i n)
      (let* ((id (format "seed-%04d-0000-0000-0000-000000000000" i))
             (cwd (file-name-as-directory (make-temp-file (format "bench-seed-%d-" i) t)))
             (record (list :id id :name (format "seeded %d" i) :cwd cwd
                           :created (- (float-time) 3600) :updated (- (float-time) 60)
                           :model "demo:scripted" :permission-mode "yolo"
                           :status "idle" :usage (list :input 0 :output 0 :cost 0.0))))
        (with-temp-file (expand-file-name (format "%s.json" id) dir)
          (insert (json-encode record)))
        (with-temp-file (expand-file-name (format "%s.nodes.jsonl" id) dir)
          (dotimes (k nodes-each)
            (insert (json-encode (list :id (format "n-%s-%d" id k)
                                       :kind (if (= 0 (% k 2)) "user" "assistant")
                                       :content text
                                       :session id
                                       :ts (- (float-time) (* 60 k))
                                       :parent nil)))
            (insert "\n")))))
    (format "%d sessions x %d nodes (~%d KB each)" n nodes-each (/ (* bytes-each 1024) 1024))))

;;;; Proving this measures the real thing

(defun bench-e2e-assert-real ()
  "Assert the bench is on the production path.  Return a plist of facts.
A fast number from a server that loaded 7 of 170 modules is exactly the
error this bench exists to avoid, so it is an error here, not a warning."
  (unless (and bench-e2e--conn (harness-acp-connected-p bench-e2e--conn))
    (error "Bench: no ACP client connected; fan-out would not be measured"))
  (let* ((modules (car (bench-e2e-call "_harness/harness/modules" nil 60)))
         ;; The answer is the list of module descriptions itself.
         (n (length modules)))
    (unless (> n 80)
      (error "Bench: server loaded only %d modules, not the production path" n))
    (let* ((sessions (car (bench-e2e-call "session/list" nil 60)))
           (slist (plist-get sessions :sessions)))
      (unless slist (error "Bench: session/list returned no sessions"))
      (list :modules n :sessions (length slist)
            :address bench-e2e--address))))

;;;; Driving real turns

(defun bench-e2e-new-session (i)
  "Create a session with a real cwd, as a UI does."
  (let* ((cwd (file-name-as-directory (make-temp-file (format "bench-e2e-cwd-%d-" i) t)))
         (r (car (bench-e2e-call "session/new" (list :cwd cwd :mcpServers nil) 60))))
    (or (plist-get r :sessionId) (plist-get r :id)
        (error "Bench: session/new returned no id: %S" r))))

(defun bench-e2e-delta-p (note)
  "Non-nil when NOTE is a streamed chunk of a session's answer.
The wire shape is a `session/update' notification whose `update' names
the chunk kind, not a top-level `sessionUpdate'."
  (let* ((params (plist-get (cdr note) :params))
         (update (plist-get params :update)))
    (member (plist-get update :sessionUpdate)
            '("agent_message_chunk" "agent_thought_chunk"))))

(defun bench-e2e-prompt (sid text)
  "Send TEXT as a prompt to SID; return what the turn cost.
The deltas are counted from the notifications the server sent while the
turn ran, so the count is what a client actually received."
  (setq bench-e2e--notes nil)
  (let* ((t0 (float-time))
         (answer (bench-e2e-call "session/prompt"
                                 (list :sessionId sid
                                       :prompt (vector (list :type "text" :text text)))
                                 300))
         (total (- (float-time) t0))
         (deltas (cl-count-if #'bench-e2e-delta-p bench-e2e--notes)))
    (list :total total
          :deltas deltas
          :stop-reason (plist-get (car answer) :stopReason))))

;;;; Heartbeat: the stutter a user feels

(defun bench-e2e-stream-level (n seconds)
  "Drive N concurrent turns for SECONDS; return stutter statistics.
The heartbeat runs in the CLIENT process, so its lateness includes the
whole round trip: server work, encode, socket, and client parse."
  (let* ((sids (cl-loop for i below n collect (bench-e2e-new-session i)))
         (beat (/ 1.0 50))
         (last (float-time))
         (late nil)
         (deadline (+ (float-time) seconds))
         (hb nil))
    ;; Start every session's turn; they stream concurrently.
    (dolist (sid sids)
      (harness-acp-request bench-e2e--conn "session/prompt"
                           (list :sessionId sid
                                 :prompt (vector (list :type "text" :text "stream")))))
    (setq hb (run-at-time beat beat
                          (lambda ()
                            (let* ((now (float-time))
                                   (drift (- now last beat)))
                              (when (< now deadline) (push drift late))
                              (setq last now)))))
    (while (< (float-time) deadline)
      (accept-process-output nil 0.02))
    (cancel-timer hb)
    (let* ((sorted (sort (copy-sequence late) #'>))
           (pct (lambda (p) (* 1000 (or (nth (min (1- (length sorted))
                                                (floor (* p (length sorted)))) sorted)
                                        0.0)))))
      (list :sessions n
            :beats (length late)
            :p50 (funcall pct 0.50) :p95 (funcall pct 0.05)
            :max (funcall pct 0.0)
            :over-100ms (cl-count-if (lambda (x) (> x 0.1)) late)
            :over-1s (cl-count-if (lambda (x) (> x 1.0)) late)))))

;;;; Run

(defun bench-e2e-report-connect (label c)
  "Print one connect result C under LABEL."
  (princ (format "%-10s socket %6.0f ms  initialize %6.0f ms  auth %6.0f ms  total %6.0f ms\n"
                 label
                 (* 1000 (plist-get c :socket))
                 (* 1000 (plist-get c :initialize))
                 (* 1000 (or (plist-get c :authenticate) 0))
                 (* 1000 (plist-get c :total)))))

(defun bench-e2e-report-level (s)
  "Print one concurrency result S."
  (princ (format "sessions=%-3d beats=%-4d late p50=%7.1fms p95=%7.1fms max=%8.1fms >100ms=%-3d >1s=%d\n"
                 (plist-get s :sessions) (plist-get s :beats)
                 (plist-get s :p50) (plist-get s :p95) (plist-get s :max)
                 (plist-get s :over-100ms) (plist-get s :over-1s))))

(defun bench-e2e-measure-once ()
  "Connect, prove the path is real, time one prompt, then reconnect."
  (bench-e2e-report-connect "connect" (bench-e2e-connect))
  (let ((facts (bench-e2e-assert-real)))
    (princ (format "verified   %d modules loaded, %d sessions; not a subset\n"
                   (plist-get facts :modules) (plist-get facts :sessions))))
  (let* ((sid (bench-e2e-new-session 0))
         (p (bench-e2e-prompt sid "stream")))
    (princ (format "prompt     total %.2f s, %d deltas, stop=%s\n"
                   (plist-get p :total) (plist-get p :deltas)
                   (plist-get p :stop-reason))))
  (bench-e2e-disconnect)
  (bench-e2e-report-connect "reconnect" (bench-e2e-connect)))

(defun bench-e2e-measure-levels ()
  "Measure stutter at each concurrency level."
  (dolist (n bench-e2e-levels)
    (bench-e2e-report-level (bench-e2e-stream-level n bench-e2e-stream-seconds))))

(defun bench-e2e-run ()
  "Run the whole end-to-end benchmark."
  (unwind-protect
      (progn
        (princ (format "server     %s\n" (bench-e2e-start-server)))
        (bench-e2e-measure-once)
        (bench-e2e-measure-levels))
    (bench-e2e-stop-server)))

(provide 'bench-end-to-end)
;;; bench-end-to-end.el ends here

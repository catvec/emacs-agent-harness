#!/usr/bin/env python3
"""A scripted live voice sidecar for the harness.

It speaks the JSON-lines sidecar protocol used by ui-voice without a
microphone, speaker, speech model or network.  Use it to try the live
controls, to show them in documentation, or as the starting point for a
real GPT-Live or local pipeline adapter.

Usage:
    harness-voice-live-fixture [--demo [--hold-speaking]]

The harness starts this process and writes one JSON object per line on
stdin.  This process writes one JSON object per line on stdout and
diagnostics on stderr.  With --demo it also simulates a user asking for
work, and the capture path's scripted measurements: levels, a burst the
speech filter kept and one it dropped.  Without --demo it only answers
the harness's lifecycle commands.

The demo's audio events are scripted -- no microphone measured them --
but they carry the same fields a real sidecar's `level' and `segment'
events do.  --hold-speaking keeps the last playback report at speaking
until the session stops, so a picture of a session in progress does not
depend on how long a screenshot takes; every other event is the same.
"""

import json
import sys
import time


def send(event, **fields):
    """Write one protocol event and flush it."""
    message = {"event": event}
    message.update(fields)
    sys.stdout.write(json.dumps(message, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def log(text):
    """Write a diagnostic line where it cannot corrupt the protocol."""
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


DEMO_UTTERANCE = "Add a docstring to the parse function in file.py."


def demo_pipeline():
    """Emit the capture path a real sidecar would report, scripted.

    Left to right: levels before the filter, a burst the filter kept and
    transcribed, and a short burst it dropped.  The numbers are made up;
    the events are the sidecar's own, so the harness draws them the way it
    draws a real session's.
    """
    for level in (0.18, 0.34, 0.56):
        send("level", input=level)
    send("speech", active=True, utterance=1, reason="onset")
    send("segment", state="accepted", id="u-1", seconds=1.4)
    send("hearing", utterance=1)
    send("speech", active=False, utterance=1, reason="hangover")
    send("level", input=0.21)
    send("speech", active=True, utterance=2, reason="onset")
    send("speech", active=False, utterance=2, reason="hangover")
    send("segment", state="dropped", id="u-2", seconds=0.08, reason="too short")
    send("transcribing", utterance=1)
    send("user_delta", text=DEMO_UTTERANCE, final=True, utterance=1)
    send("segment", state="transcribed", id="u-1")
    send("delegation", id="fixture-1", text=DEMO_UTTERANCE)


def demo_delegation():
    """Ask the harness for a small piece of work, as a voice user would."""
    demo_pipeline()


def main(argv):
    demo = "--demo" in argv[1:]
    hold_speaking = "--hold-speaking" in argv[1:]
    log("fixture ready" + (" (demo)" if demo else ""))
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except ValueError as error:
            log("invalid JSON from harness: %s" % error)
            continue
        if not isinstance(event, dict):
            log("protocol event is not an object")
            continue
        kind = event.get("event")
        if kind == "start":
            send("ready", provider="fixture")
            send("listening")
            if demo:
                demo_delegation()
        elif kind == "mute":
            log("microphone %s" % ("muted" if event.get("on") else "open"))
        elif kind == "interrupt":
            send("interrupted")
            send("listening")
        elif kind == "commentary":
            send("speaking")
            if hold_speaking:
                continue
            time.sleep(0.3)
            send("listening")
        elif kind == "delegate_result":
            if demo:
                if event.get("error"):
                    send("assistant_delta", text="That did not work.", final=True)
                else:
                    send("assistant_delta", text="The docstring is in place.", final=True)
                send("listening")
        elif kind == "stop":
            send("closed", reason="fixture stopped")
            return 0
        else:
            log("ignored %s" % kind)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(0)

#!/usr/bin/env python3
"""A local pipeline sidecar for the harness's `unmute` voice provider.

Emacs starts this script as the ``unmute`` voice provider.  It listens
on the microphone, cuts the audio into utterances with an energy voice
detector, transcribes each one, delegates the text to the harness agent
in the current chat, and speaks the reply.  Everything runs on this
machine: the script only talks to a local, OpenAI-compatible speech
server, by default [Kyutai Unmute](https://github.com/kyutai-labs/unmute)
on port 8000.

    scripts/harness-voice-live-unmute [--stt-url URL] [--tts-url URL]
                                      [--voice unmute] [--threshold 0.02]
                                      [--self-test]

The two endpoints follow the OpenAI audio API, so whisper.cpp's server,
Piper behind a small HTTP wrapper, or any compatible service can replace
Unmute without changing Emacs:

    POST /v1/audio/transcriptions   multipart: file, model, response_format=json
                                    -> {"text": "add a docstring"}
    POST /v1/audio/speech           {"model", "voice", "input", "response_format": "wav"}
                                    -> WAV bytes

Audio is PCM16 mono at 16 kHz, captured with ``arecord`` and played
with ``aplay``.  No audio leaves the machine, and the sidecar needs no
API key unless ``--api-key-env`` names a variable holding one for a
protected endpoint.
"""

import argparse
import base64
import collections
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from harness_voice_sidecar import (  # noqa: E402
    LOCAL_RATE, FakeEvents, Loop, NullAudio, Player, Recorder, Sidecar, Vad,
    http_json, http_multipart, log, pcm_from_wav, self_test_failed,
    self_test_ok, wav_from_pcm,
)

DEFAULT_STT_URL = "http://127.0.0.1:8000/v1/audio/transcriptions"
DEFAULT_TTS_URL = "http://127.0.0.1:8000/v1/audio/speech"


class UnmuteSidecar(Sidecar):
    """Local speech-to-text, delegation and text-to-speech."""

    provider = "unmute"

    def __init__(self, args, events=None, player=None, recorder=None,
                 post_multipart=None, post_json=None):
        super().__init__(events=events, player=player or Player(LOCAL_RATE),
                         rate=LOCAL_RATE)
        self.args = args
        self.recorder = recorder or Recorder(LOCAL_RATE)
        self.vad = Vad(LOCAL_RATE, threshold=args.threshold)
        self.post_multipart = post_multipart or http_multipart
        self.post_json = post_json or http_json
        self.queue = collections.deque()
        self.started = False
        self.heard = ""
        self.failures = 0
        self.errors = 0

    # -- lifecycle ---------------------------------------------------

    def on_start(self):
        self.started = True

    def on_stop(self):
        self.recorder.close()
        self.queue.clear()

    def on_mute(self, muted):
        # A partial utterance from before the mute must not surface later.
        self.vad = Vad(self.rate, threshold=self.args.threshold)
        log("microphone %s" % ("muted" if muted else "open"))

    def interrupt(self):
        """Silence the reply and drop what was queued behind it."""
        self.queue.clear()
        super().interrupt()

    def fail(self, message):
        """Report a failure that ends the session."""
        self.failures += 1
        self.events.send("error", message=message)
        if self.loop is not None:
            self.loop.stop(1)

    # -- audio -------------------------------------------------------

    def on_tick(self):
        try:
            self.tick()
        except Exception as error:  # noqa: BLE001 - a loop must not die
            self.errors += 1
            log("local voice tick failed: %s: %s" % (type(error).__name__, error))
            if self.errors >= 10:
                self.fail("Local voice loop failed · %s" % error)

    def tick(self):
        if not self.started:
            return
        self.tick_playback()
        self.pump()
        chunk = self.recorder.read(800)  # 50 ms at 16 kHz
        if not chunk:
            return
        if len(chunk) % 2:
            chunk = chunk[:-1]
        if self.muted:
            return
        for result in self.vad.feed(chunk):
            if result[0] == "start":
                self.events.send("hearing")
            elif result[0] == "speech":
                self.events.send("transcribing")
                self.handle_speech(result[1])
            elif result[0] == "cancel":
                # Too short to transcribe: back to listening, not stuck
                # in a stage that waits for text that will not come.
                self.events.send("listening")

    def handle_speech(self, pcm):
        """Transcribe one utterance and delegate it to the agent."""
        text = self.transcribe(pcm)
        if not text:
            # Silence, noise or an empty STT result: nothing to delegate.
            self.events.send("listening")
            return
        self.heard = text
        self.events.send("user_delta", text=text, final=True)
        self.delegation(text)

    # -- services ----------------------------------------------------

    def headers(self):
        """Return the bearer header, when a key variable is configured."""
        name = self.args.api_key_env
        if not name:
            return {}
        key = os.environ.get(name, "")
        return {"Authorization": "Bearer %s" % key} if key else {}

    def transcribe(self, pcm):
        """Return the text of one recorded utterance, or nil."""
        data = wav_from_pcm(pcm, self.rate)
        try:
            body = self.post_multipart(
                self.args.stt_url,
                {"model": self.args.stt_model, "response_format": "json"},
                "utterance.wav", data, headers=self.headers(), timeout=120)
        except Exception as error:  # noqa: BLE001 - shown in Emacs
            self.failures += 1
            self.events.send("error", message="Local transcription failed · %s" % error)
            return ""
        try:
            payload = json.loads(body.decode("utf-8")) if body else {}
        except ValueError:
            self.events.send("error", message="Local transcription · invalid response")
            return ""
        text = (payload.get("text") or "").strip()
        if not text:
            return ""
        return text

    def speak(self, text):
        """Queue TEXT for speech; one utterance plays at a time."""
        text = (text or "").strip()
        if text:
            self.queue.append(text)

    def pump(self):
        """Speak the next queued reply when the speaker is free."""
        if not self.queue or (self.player and self.player.busy()):
            return
        text = self.queue.popleft()
        pcm = self.synthesize(text)
        if pcm:
            self.play(pcm)

    def synthesize(self, text):
        """Return PCM16 for TEXT, or nil when synthesis fails."""
        try:
            body = self.post_json(
                self.args.tts_url,
                {"model": self.args.tts_model, "voice": self.args.voice,
                 "input": text, "response_format": "wav"},
                headers=self.headers(), timeout=120)
        except Exception as error:  # noqa: BLE001 - shown in Emacs
            self.failures += 1
            self.events.send("error", message="Local speech failed · %s" % error)
            return b""
        data = body if isinstance(body, bytes) else b""
        if not data.startswith(b"RIFF") and isinstance(body, dict):
            # http_json wraps non-JSON bodies in {"data": bytes}; a server
            # that answers JSON carries the audio base64-encoded.
            raw = body.get("audio") or body.get("data") or b""
            if isinstance(raw, bytes):
                data = raw
            elif isinstance(raw, str):
                try:
                    data = base64.b64decode(raw)
                except (ValueError, TypeError):
                    data = b""
        if not data.startswith(b"RIFF"):
            self.failures += 1
            self.events.send("error", message="Local speech · no audio returned")
            return b""
        try:
            return pcm_from_wav(data)
        except (EOFError, ValueError) as error:
            self.failures += 1
            self.events.send("error", message="Local speech · bad WAV · %s" % error)
            return b""

    # -- replies -----------------------------------------------------

    def on_result(self, delegation_id, text, error):
        if error:
            return
        self.speak(text)

    def on_commentary(self, text):
        self.speak(text)


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Local live-voice sidecar for the harness")
    parser.add_argument("--stt-url", default=DEFAULT_STT_URL)
    parser.add_argument("--tts-url", default=DEFAULT_TTS_URL)
    parser.add_argument("--stt-model", default="whisper-1")
    parser.add_argument("--tts-model", default="tts-1")
    parser.add_argument("--voice", default="unmute")
    parser.add_argument("--threshold", type=float, default=0.02)
    parser.add_argument("--api-key-env", default="")
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args(argv[1:])


def self_test(args):
    """Run the pipeline against fake audio and fake speech services."""
    calls = {"stt": [], "tts": []}

    def post_multipart(url, fields, filename, data, headers=None, timeout=120):
        calls["stt"].append({"url": url, "fields": fields, "bytes": len(data)})
        if not data.startswith(b"RIFF"):
            raise ValueError("not a WAV")
        return json.dumps({"text": "add a docstring"}).encode("utf-8")

    def post_json(url, payload, headers=None, timeout=60, method=None):
        calls["tts"].append({"url": url, "payload": payload})
        return {"data": wav_from_pcm(b"\x00\x01" * 800, LOCAL_RATE)}

    events = FakeEvents()
    player = NullAudio()
    sidecar = UnmuteSidecar(args, events=events, player=player,
                            recorder=NullAudio(),
                            post_multipart=post_multipart, post_json=post_json)
    sidecar.start_session({"event": "start", "protocol": 1})
    # One utterance: a wave of speech crosses the threshold and ends.
    speech = b"\x00\x20" * 8000  # 0.5 s of tone
    for result in sidecar.vad.feed(speech + b"\x00\x00" * 12000):
        if result[0] == "speech":
            sidecar.handle_speech(result[1])
    if not calls["stt"]:
        return self_test_failed("no transcription request")
    delegations = [event for event in events.sent if event.get("event") == "delegation"]
    if not delegations or delegations[0].get("text") != "add a docstring":
        return self_test_failed("delegation text")
    captions = [event for event in events.sent if event.get("event") == "user_delta"]
    if not captions or captions[-1].get("final") is not True:
        return self_test_failed("user caption")
    # The agent's answer is spoken and reported as speaking.
    sidecar.handle({"event": "delegate_result", "id": delegations[0]["id"],
                    "text": "It is in place."})
    sidecar.pump()
    if not calls["tts"]:
        return self_test_failed("no speech request")
    if calls["tts"][0]["payload"].get("input") != "It is in place.":
        return self_test_failed("speech text")
    if not player.played:
        return self_test_failed("nothing played")
    if "speaking" not in events.names():
        return self_test_failed("no speaking event")
    # Commentary is queued the same way.
    sidecar.handle({"event": "commentary", "text": "Working on it."})
    sidecar.pump()
    if calls["tts"][-1]["payload"].get("input") != "Working on it.":
        return self_test_failed("commentary not spoken")
    # Interruption drops the queue and reports it.
    sidecar.handle({"event": "commentary", "text": "Never mind."})
    sidecar.handle({"event": "interrupt"})
    if sidecar.queue:
        return self_test_failed("queue survived interrupt")
    if "interrupted" not in events.names():
        return self_test_failed("no interrupt event")
    # Stopping closes the recorder and player.
    sidecar.handle({"event": "stop"})
    if "closed" not in events.names():
        return self_test_failed("no closed event")
    return self_test_ok("harness-voice-live-unmute")


def main(argv):
    args = parse_args(argv)
    if args.self_test:
        return self_test(args)
    sidecar = UnmuteSidecar(args)
    reason = sidecar.recorder.available()
    if reason:
        sidecar.events.send("error", message=reason)
        return 1
    loop = Loop(sidecar.events)
    sidecar.loop = loop
    try:
        return loop.run(sidecar.handle, sidecar.on_tick)
    except KeyboardInterrupt:
        return 0
    finally:
        sidecar.recorder.close()
        sidecar.player.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))

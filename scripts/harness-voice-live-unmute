#!/usr/bin/env python3
"""A local pipeline sidecar for the harness's `unmute` voice provider.

Emacs starts this script as the ``unmute`` voice provider.  It listens
on the microphone, cuts the audio into utterances with an energy voice
detector, transcribes each one, delegates the text to the harness agent
in the current chat, and speaks the reply.  Everything runs on this
machine: the script only talks to local, OpenAI-compatible speech
servers -- the bundled voice-local stack's whisper.cpp for speech to
text and Kokoro for text to speech.

    scripts/harness-voice-live-unmute [--stt-url URL] [--tts-url URL]
                                      [--voice af_heart] [--threshold 0.004]
                                      [--self-test]

The two endpoints follow the OpenAI audio API, so whisper.cpp's server,
Kokoro, a Piper server behind a small HTTP wrapper, or any compatible
service can replace the stack without changing Emacs:

    POST /v1/audio/transcriptions   multipart: file, model, response_format=json
                                    -> {"text": "add a docstring"}
    POST /v1/audio/speech           {"model", "voice", "input", "response_format": "wav"}
                                    -> WAV bytes

Audio is captured and played as PCM16 mono at 16 kHz through the
machine's audio backend -- PipeWire's ``pw-record`` and ``pw-play``,
PulseAudio's ``parec`` and ``paplay``, ALSA's ``arecord`` and ``aplay``,
or ``ffmpeg`` -- and ``--audio`` names one instead of taking the first
installed.  A speech reply is resampled from the rate its server
returns to 16 kHz.  No audio leaves the machine, and the sidecar needs
no API key unless ``--api-key-env`` names a variable holding one for a
protected endpoint.
"""

import argparse
import base64
import collections
import json
import os
import queue
import re
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from harness_voice_sidecar import (  # noqa: E402
    AUDIO_AUTO, CAPTURE_SECONDS, LOCAL_RATE, FakeEvents, Loop, NullAudio,
    Player, Recorder,
    Sidecar, Vad, audio_backend_names, http_json, http_multipart, log,
    pcm_from_wav, self_test_audio, self_test_failed, self_test_ok, wav_from_pcm,
)

DEFAULT_STT_URL = "http://127.0.0.1:8080/inference"
DEFAULT_TTS_URL = "http://127.0.0.1:8880/v1/audio/speech"


def _normal(text):
    """Return TEXT with whitespace and case flattened, for a duplicate check."""
    return re.sub(r"\s+", " ", (text or "").strip().lower())


class UnmuteSidecar(Sidecar):
    """Local speech-to-text, delegation and text-to-speech.

    Capture, detection and playback run on the sidecar's loop; speech-to-text
    and synthesis run on workers.  A long transcription or a slow speech
    server therefore never stops the microphone or the gate from noticing
    the next words.  Everything the assistant would say is held while a
    person speaks, and a held reply is reported with the transcript that
    interrupted it instead of being replayed afterwards.
    """

    provider = "unmute"

    def __init__(self, args, events=None, player=None, recorder=None,
                 post_multipart=None, post_json=None):
        audio = getattr(args, "audio", AUDIO_AUTO)
        super().__init__(events=events,
                         player=player or Player(LOCAL_RATE, backend=audio),
                         rate=LOCAL_RATE)
        self.args = args
        self.recorder = recorder or Recorder(LOCAL_RATE, backend=audio)
        self.vad = Vad(
            LOCAL_RATE, threshold=args.threshold,
            hangover=getattr(args, "hangover", 0.85),
            max_speech=getattr(args, "max_speech", 120.0))
        self.post_multipart = post_multipart or http_multipart
        self.post_json = post_json or http_json
        self.started = False
        self.heard = ""
        self.failures = 0
        self.errors = 0
        self.transcriptions = queue.Queue()
        self.transcripts = queue.Queue()
        self.speech_items = queue.Queue()
        self.audio = queue.Queue()
        self.ready = collections.deque()
        self.workers = []
        self.stopping = threading.Event()
        self.awaiting = set()
        self.next_utterance = 1
        self.buffered = {}
        self.release_at = None
        self.commentary = []
        self.said = []

    # -- lifecycle ---------------------------------------------------

    def start_session(self, event):
        self.vad.reset()
        self.buffered.clear()
        self.awaiting.clear()
        self.next_utterance = self.vad._uid + 1
        self.release_at = None
        self.heard = ""
        super().start_session(event)

    def on_start(self):
        reason = self.recorder.available()
        if reason:
            self.fail(reason)
            return
        self.stopping.clear()
        self.started = True
        self._start_workers()

    def _start_workers(self):
        if self.workers:
            return
        for name, target in (("voice-stt", self._transcribe_loop),
                             ("voice-tts", self._synthesize_loop)):
            worker = threading.Thread(target=target, name=name, daemon=True)
            worker.start()
            self.workers.append(worker)

    def on_stop(self):
        self.stopping.set()
        self.transcriptions.put(None)
        self.speech_items.put(None)
        for worker in self.workers:
            worker.join(timeout=2)
        self.workers = []
        self.recorder.close()
        self.vad.reset()
        self.buffered.clear()
        self.awaiting.clear()
        self.next_utterance = self.vad._uid + 1
        self.release_at = None
        self.ready.clear()
        self.held = []
        self.speech_active = False
        self._clear_queues()
        self.started = False

    def _clear_queues(self):
        for work in (self.transcriptions, self.transcripts,
                     self.speech_items, self.audio):
            while True:
                try:
                    work.get_nowait()
                except queue.Empty:
                    break
        self.ready.clear()

    def on_mute(self, muted):
        # A partial utterance from before the mute must not surface later.
        self.vad.reset()
        self.awaiting.clear()
        self.buffered.clear()
        self.next_utterance = max(self.next_utterance, self.vad._uid + 1)
        self.speech_active = False
        self.held = []
        self.announce_speech(False, reason="muted")
        if muted and self.player:
            self.player.stop()
        self._clear_queues()
        log("microphone %s" % ("muted" if muted else "open"))

    def interrupt(self):
        """Silence the reply and drop what was queued behind it."""
        self.held = []
        self._clear_queues()
        super().interrupt()

    def fail(self, message):
        """Report a failure that ends the session."""
        self.failures += 1
        self.events.send("error", message=message)
        if self.loop is not None:
            self.loop.stop(1)

    # -- audio -------------------------------------------------------

    def on_tick(self):
        try:
            self.tick()
        except Exception as error:  # noqa: BLE001 - a loop must not die
            self.errors += 1
            log("local voice tick failed: %s: %s" % (type(error).__name__, error))
            if self.errors >= 10:
                self.fail("Local voice loop failed · %s" % error)

    def tick(self):
        if not self.started:
            return
        if self.recorder.exhausted():
            # Every backend died: say why instead of waiting on silence.
            self.fail(self.recorder.error or "microphone unavailable")
            return
        self.tick_playback()
        # Up to 200 ms: a tick is 20 ms, so one read also drains a
        # backlog rather than letting the capture pipe fill.
        chunk = self.recorder.read(int(self.rate * CAPTURE_SECONDS))
        if chunk:
            if len(chunk) % 2:
                chunk = chunk[:-1]
            if not self.muted:
                self.announce_level(self.level_meter.measure(chunk))
                self.vad.set_playback(
                    self.player.level() if self.player else 0.0)
                self._consume(self.vad.feed(chunk))
        self.drain_transcripts()
        self.drain_audio()
        self.maybe_release()

    def _consume(self, events):
        for result in events:
            kind = result[0]
            if kind == "start":
                self.speech_active = True
                self.cancel_release()
                self.announce_speech(True, result[1], "onset")
                self.events.send("hearing", utterance=result[1])
                if self.player and self.player.busy():
                    self.player.stop()
            elif kind == "end":
                self.speech_active = False
                self.announce_speech(False, result[1], "utterance-end")
            elif kind == "speech":
                uid = result[2]
                self.announce_segment("accepted", uid,
                                      len(result[1]) / (2.0 * self.rate))
                self.awaiting.add(uid)
                self.events.send("transcribing", utterance=uid)
                self.transcriptions.put((uid, result[1]))
            elif kind == "cancel":
                # Too short to transcribe: back to listening, not stuck
                # in a stage that waits for text that will not come.
                self.announce_segment("dropped", result[1],
                                      result[2] if len(result) > 2 else None,
                                      "too short")
                self.events.send("listening", utterance=result[1])
                self.schedule_release(1.0)

    def gate_blocked(self):
        """Non-nil while assistant audio must not start."""
        return bool(self.muted or self.speech_active or self.awaiting)

    def schedule_release(self, seconds):
        """Release held output after SECONDS if no real utterance follows."""
        if self.held:
            self.release_at = time.monotonic() + seconds

    def cancel_release(self):
        self.release_at = None

    def maybe_release(self):
        """Let a false trigger's held reply go, but only with no transcript."""
        if (not self.release_at or self.gate_blocked()
                or time.monotonic() < self.release_at):
            return
        pending, self.held = self.held, []
        self.release_at = None
        for item in pending:
            self.speak(item.get("text") or "", item.get("id"))

    # -- workers -----------------------------------------------------

    def _transcribe_loop(self):
        while not self.stopping.is_set():
            item = self.transcriptions.get()
            if item is None:
                return
            uid, pcm = item
            text = self.transcribe(pcm)
            if not self.stopping.is_set():
                self.transcripts.put((uid, text))

    def _synthesize_loop(self):
        while not self.stopping.is_set():
            item = self.speech_items.get()
            if item is None:
                return
            item_id, text = item
            pcm = self.synthesize(text)
            if pcm and not self.stopping.is_set():
                self.audio.put((item_id, text, pcm))

    def drain_transcripts(self):
        """Deliver completed transcripts in utterance order, exactly once."""
        while True:
            try:
                uid, text = self.transcripts.get_nowait()
            except queue.Empty:
                break
            if uid < self.next_utterance:
                # Mute dropped this utterance while it was being transcribed.
                continue
            self.buffered[uid] = text
        while self.next_utterance in self.buffered:
            uid = self.next_utterance
            text = self.buffered.pop(uid)
            self.next_utterance += 1
            self.awaiting.discard(uid)
            if text is None:
                # The transcription itself failed; the error event says
                # why, and the burst's marker says it never became words.
                self.announce_segment("failed", uid)
                self.events.send("listening", utterance=uid)
                self.schedule_release(1.0)
                continue
            if not text:
                # Silence, noise or an empty STT result: nothing to delegate.
                self.announce_segment("dropped", uid, reason="no words")
                self.events.send("listening", utterance=uid)
                self.schedule_release(1.0)
                continue
            self.heard = text
            pending = self.take_pending()
            self.events.send("user_delta", text=text, final=True, utterance=uid)
            self.delegation(text, delegation_id="u-%d" % uid,
                            pending=pending, utterance=uid)

    def drain_audio(self):
        """Play ready PCM only while the gate is open; hold everything else."""
        if self.gate_blocked():
            while self.ready:
                item = self.ready.popleft()
                self.hold(item[1], item[0])
            while True:
                try:
                    item = self.audio.get_nowait()
                except queue.Empty:
                    break
                self.hold(item[1], item[0])
            return
        if self.ready and not (self.player and self.player.busy()):
            item = self.ready.popleft()
            self._play_item(item)
        while not self.ready:
            try:
                item = self.audio.get_nowait()
            except queue.Empty:
                break
            if self.gate_blocked():
                self.hold(item[1], item[0])
                continue
            if self.player and self.player.busy():
                self.ready.append(item)
                break
            self._play_item(item)

    def _play_item(self, item):
        item_id, text, pcm = item
        if self.play(pcm):
            self.said.append(text)
        else:
            self.hold(text, item_id)

    # -- services ----------------------------------------------------

    def headers(self):
        """Return the bearer header, when a key variable is configured."""
        name = self.args.api_key_env
        if not name:
            return {}
        key = os.environ.get(name, "")
        return {"Authorization": "Bearer %s" % key} if key else {}

    def transcribe(self, pcm):
        """Return the text of one recorded utterance, or nil."""
        data = wav_from_pcm(pcm, self.rate)
        try:
            body = self.post_multipart(
                self.args.stt_url,
                {"model": self.args.stt_model, "response_format": "json"},
                "utterance.wav", data, headers=self.headers(), timeout=120)
        except Exception as error:  # noqa: BLE001 - shown in Emacs
            self.failures += 1
            self.events.send("error", message="Local transcription failed · %s" % error)
            return None
        try:
            payload = json.loads(body.decode("utf-8")) if body else {}
        except ValueError:
            self.events.send("error", message="Local transcription · invalid response")
            return None
        text = (payload.get("text") or "").strip()
        if not text:
            return ""
        return text

    def speak(self, text, item_id=None):
        """Speak TEXT, or hold it when speech or a transcript owns the floor."""
        text = (text or "").strip()
        if not text or self.muted:
            return
        if self.gate_blocked():
            self.hold(text, item_id)
            return
        if not item_id:
            self.hold_seq += 1
            item_id = "say-%d" % self.hold_seq
        self.speech_items.put((item_id, text))

    def synthesize(self, text):
        """Return PCM16 for TEXT, or nil when synthesis fails."""
        try:
            body = self.post_json(
                self.args.tts_url,
                {"model": self.args.tts_model, "voice": self.args.voice,
                 "input": text, "response_format": "wav"},
                headers=self.headers(), timeout=120)
        except Exception as error:  # noqa: BLE001 - shown in Emacs
            self.failures += 1
            self.events.send("error", message="Local speech failed · %s" % error)
            return b""
        data = body if isinstance(body, bytes) else b""
        if not data.startswith(b"RIFF") and isinstance(body, dict):
            # http_json wraps non-JSON bodies in {"data": bytes}; a server
            # that answers JSON carries the audio base64-encoded.
            raw = body.get("audio") or body.get("data") or b""
            if isinstance(raw, bytes):
                data = raw
            elif isinstance(raw, str):
                try:
                    data = base64.b64decode(raw)
                except (ValueError, TypeError):
                    data = b""
        if not data.startswith(b"RIFF"):
            self.failures += 1
            self.events.send("error", message="Local speech · no audio returned")
            return b""
        try:
            return pcm_from_wav(data)
        except (EOFError, ValueError) as error:
            self.failures += 1
            self.events.send("error", message="Local speech · bad WAV · %s" % error)
            return b""

    # -- replies -----------------------------------------------------

    def _unspoken(self, text):
        """Return the sentences of TEXT that commentary has not covered."""
        said = _normal(" ".join(self.commentary))
        parts = re.split(r"(?<=[.!?])\s+", (text or "").strip())
        return " ".join(part for part in parts
                        if part and _normal(part) not in said).strip()

    def on_result(self, delegation_id, text, error):
        if error:
            return
        remaining = self._unspoken(text)
        self.commentary = []
        if remaining:
            self.speak(remaining, "result:%s" % (delegation_id or "voice"))

    def on_held_result(self, delegation_id, text):
        # The full held result is already in the pending context; the
        # sentence pieces were reported when they arrived.
        self.commentary = []

    def on_commentary(self, text, event=None):
        self.commentary.append(text)
        self.speak(text, (event or {}).get("id"))


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Local live-voice sidecar for the harness")
    parser.add_argument("--stt-url", default=DEFAULT_STT_URL)
    parser.add_argument("--tts-url", default=DEFAULT_TTS_URL)
    parser.add_argument("--stt-model", default="whisper-1")
    parser.add_argument("--tts-model", default="tts-1")
    parser.add_argument("--voice", default="af_heart")
    parser.add_argument("--threshold", type=float, default=0.004,
                        help="quietest frame energy the gate calls speech")
    parser.add_argument("--hangover", type=float, default=0.85)
    parser.add_argument("--max-speech", type=float, default=120.0)
    parser.add_argument("--api-key-env", default="")
    parser.add_argument("--audio", default=AUDIO_AUTO, choices=audio_backend_names(),
                        help="audio backend (default: the first installed)")
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args(argv[1:])


def _self_test_tone(seconds, frequency=140.0, amplitude=0.25):
    """Return a voiced-looking tone for the self-test, without a fixture."""
    import math
    import struct
    count = int(seconds * LOCAL_RATE)
    return b"".join(
        struct.pack("<h", int(32767 * amplitude
                              * math.sin(2.0 * math.pi * frequency * index / LOCAL_RATE)))
        for index in range(count))


def self_test(args):
    """Run the pipeline against fake audio and fake speech services."""
    calls = {"stt": [], "tts": []}

    def post_multipart(url, fields, filename, data, headers=None, timeout=120):
        calls["stt"].append({"url": url, "fields": fields, "bytes": len(data)})
        if not data.startswith(b"RIFF"):
            raise ValueError("not a WAV")
        return json.dumps({"text": "add a docstring"}).encode("utf-8")

    def post_json(url, payload, headers=None, timeout=60, method=None):
        calls["tts"].append({"url": url, "payload": payload})
        return {"data": wav_from_pcm(b"\x00\x01" * 800, LOCAL_RATE)}

    events = FakeEvents()
    player = NullAudio()
    sidecar = UnmuteSidecar(args, events=events, player=player,
                            recorder=NullAudio(),
                            post_multipart=post_multipart, post_json=post_json)

    def pump(timeout=3.0):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            sidecar.drain_transcripts()
            sidecar.drain_audio()
            sidecar.maybe_release()
            yield
            time.sleep(0.01)

    sidecar.start_session({"event": "start", "protocol": 1})
    # One utterance: speech crosses the gate, then a pause ends it.
    speech = _self_test_tone(1.2) + b"\x00\x00" * 24000
    for result in sidecar.vad.feed(speech):
        sidecar._consume([result])
    for _ in pump():
        if calls["stt"]:
            break
    if not calls["stt"]:
        return self_test_failed("no transcription request")
    for _ in pump():
        if any(event.get("event") == "delegation" for event in events.sent):
            break
    delegations = [event for event in events.sent if event.get("event") == "delegation"]
    if not delegations or delegations[0].get("text") != "add a docstring":
        return self_test_failed("delegation text")
    if not any(event.get("event") == "speech" and event.get("active") is True
               for event in events.sent):
        return self_test_failed("no speech onset")
    if not any(event.get("event") == "speech" and event.get("active") is False
               for event in events.sent):
        return self_test_failed("no speech end")
    captions = [event for event in events.sent if event.get("event") == "user_delta"]
    if not captions or captions[-1].get("final") is not True:
        return self_test_failed("user caption")
    # The agent's answer is spoken and reported as speaking.
    sidecar.handle({"event": "delegate_result", "id": delegations[0]["id"],
                    "text": "It is in place."})
    for _ in pump():
        if calls["tts"] and player.played:
            break
    if not calls["tts"]:
        return self_test_failed("no speech request")
    if calls["tts"][0]["payload"].get("input") != "It is in place.":
        return self_test_failed("speech text")
    if not player.played:
        return self_test_failed("nothing played")
    if "speaking" not in events.names():
        return self_test_failed("no speaking event")
    # Commentary is spoken the same way, unless speech owns the floor.
    sidecar.handle({"event": "commentary", "text": "Working on it.", "id": "c-1"})
    for _ in pump():
        if len(calls["tts"]) >= 2:
            break
    if calls["tts"][-1]["payload"].get("input") != "Working on it.":
        return self_test_failed("commentary not spoken")
    sidecar.speech_active = True
    sidecar.handle({"event": "commentary", "text": "Never mind.", "id": "c-2"})
    for _ in pump(0.2):
        pass
    if len(calls["tts"]) != 2:
        return self_test_failed("held commentary was synthesized")
    if not any(item.get("id") == "c-2" for item in sidecar.held):
        return self_test_failed("held commentary not recorded")
    sidecar.speech_active = False
    sidecar.awaiting.add(99)
    pending = sidecar.take_pending()
    if not pending:
        return self_test_failed("pending context lost")
    # Interruption drops the queue and reports it.
    sidecar.handle({"event": "commentary", "text": "Never mind.", "id": "c-3"})
    sidecar.handle({"event": "interrupt"})
    if sidecar.ready or sidecar.held:
        return self_test_failed("output survived interrupt")
    if "interrupted" not in events.names():
        return self_test_failed("no interrupt event")
    # Stopping closes the recorder and player.
    sidecar.handle({"event": "stop"})
    if "closed" not in events.names():
        return self_test_failed("no closed event")
    if sidecar.workers:
        return self_test_failed("workers survived stop")
    problem = self_test_audio()
    if problem:
        return self_test_failed(problem)
    return self_test_ok("harness-voice-live-unmute")



def main(argv):
    args = parse_args(argv)
    if args.self_test:
        return self_test(args)
    sidecar = UnmuteSidecar(args)
    reason = sidecar.recorder.available()
    if reason:
        sidecar.events.send("error", message=reason)
        return 1
    loop = Loop(sidecar.events, tick=0.02)
    sidecar.loop = loop
    try:
        return loop.run(sidecar.handle, sidecar.on_tick)
    except KeyboardInterrupt:
        return 0
    finally:
        sidecar.recorder.close()
        sidecar.player.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))

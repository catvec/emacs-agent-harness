;;; harness-module-docs.el --- Module pages, read from the modules' source  -*- lexical-binding: t; -*-

;; This file is part of the Emacs agent harness.

;;; Commentary:

;; Modules document themselves.  What a module provides to the others
;; -- methods, events, the filter chains it runs, hooks, tools, commands,
;; options -- and what it uses of them -- the methods it calls, the
;; events it handles and emits, the filter chains it joins, the hooks it
;; adds to, the modules it requires -- is read from its source, without
;; loading it.  No list kept by hand says what the code no longer does.
;;
;; `harness-module-docs-scan' reads one module file;
;; `harness-module-docs-collect' reads every module the harness can load,
;; its own and those of `harness-extra-module-directories', and links
;; them: who requires a module, which module provides a method another
;; calls.  `harness-module-docs-generate' writes a Markdown page for each
;; module and an index whose tables cross the events, filter chains and
;; hooks with the modules on either side of them: scripts/module-docs.sh
;; writes docs/modules/ with it.  `harness-describe-module' shows a page
;; in a help buffer.
;;
;; The reading is static, so a name a module computes at run time is not
;; seen, but for the common case of a `dolist' over a quoted list:
;; (dolist (ev '(a b)) (harness-on ev ...)) subscribes to a and b.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'harness-core)
(require 'harness-util)

(defvar harness-directory)
(defvar harness-module-directories)
(defvar harness--module-groups)
(declare-function harness--extra-module-directories "harness")
(declare-function harness-module-default-p "harness" (name))

(defconst harness-module-docs-header
  "<!-- Generated by scripts/module-docs.sh from the module's source; edit the source, not this page. -->"
  "First line of every page `harness-module-docs-generate' writes.
It replaces or deletes only the pages that start with it.")

(defconst harness-module-docs--lists
  '(:file-requires :methods :tools :providers :events :emits :handles :ui-events :forwards
    :filters-run :filters-joined :calls :checks :hooks-defined :hooks-used :options :commands)
  "The keys of a scan that hold lists, in the order a scan lists them.")

(defconst harness-module-docs--ui-event-hook 'harness-ui-event-functions
  "The hook a UI module hears the harness's events through, over ACP.")

(defconst harness-module-docs--forwarded-variables
  '(harness-acp--forwarded-events harness-acp-extra-events)
  "Variables listing the bus events the ACP server forwards to the UI.
A module forwards events by defining the first or adding to the second.")

;;;; Reading a module file

(defun harness-module-docs--forms (file)
  "Return the top-level forms of FILE, read without evaluating them."
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (let (forms)
      (condition-case nil
          (while t (push (read (current-buffer)) forms))
        (end-of-file nil))
      (nreverse forms))))

(defun harness-module-docs--commentary (file)
  "Return the text of FILE's Commentary section, comment starters removed.
Nil when FILE has none, or an empty one."
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (when (re-search-forward "^;;; Commentary:[ \t]*$" nil t)
      (let ((start (line-beginning-position 2))
            (end (if (re-search-forward "^;;; Code:" nil t) (line-beginning-position) (point-max)))
            (lines nil))
        (goto-char start)
        (while (< (point) end)
          (let ((line (buffer-substring-no-properties (point) (line-end-position))))
            (push (if (string-match "\\`;;+ ?" line) (substring line (match-end 0)) line) lines))
          (forward-line 1))
        (let ((text (string-trim (string-join (nreverse lines) "\n"))))
          (unless (string-empty-p text) text))))))

(defun harness-module-docs--symbol (form)
  "Return the symbol FORM quotes, as \\='SYM or #\\='SYM, or nil."
  (and (memq (car-safe form) '(quote function))
       (symbolp (cadr form))
       (cadr form)))

(defun harness-module-docs--fn (form)
  "Return what FORM, a function argument, names: its symbol, or \"lambda\"."
  (or (harness-module-docs--symbol form) "lambda"))

(defun harness-module-docs--names (form env)
  "Return the names FORM stands for, a list of symbols.
FORM is \\='NAME, a variable ENV binds to the elements of a quoted list
\(see `harness-module-docs--walk'), or (car VAR) of such a variable,
whose elements are then conses."
  (cond ((harness-module-docs--symbol form) (list (harness-module-docs--symbol form)))
        ((and (symbolp form) (assq form env))
         (cl-remove-if-not #'symbolp (cdr (assq form env))))
        ((and (eq (car-safe form) 'car) (assq (cadr form) env))
         (cl-loop for e in (cdr (assq (cadr form) env))
                  when (and (consp e) (symbolp (car e))) collect (car e)))))

(defun harness-module-docs--event-docs (name-form doc-form env)
  "Return ((NAME . DOC) ...) for (harness-declare-event NAME-FORM DOC-FORM).
ENV is as for `harness-module-docs--names'."
  (if (and (eq (car-safe name-form) 'car) (eq (car-safe doc-form) 'cdr)
           (eq (cadr name-form) (cadr doc-form)) (assq (cadr name-form) env))
      (cl-loop for e in (cdr (assq (cadr name-form) env))
               when (and (consp e) (symbolp (car e)))
               collect (cons (car e) (and (stringp (cdr e)) (cdr e))))
    (mapcar (lambda (n) (cons n (and (stringp doc-form) doc-form)))
            (harness-module-docs--names name-form env))))

(defun harness-module-docs--interactive-p (body)
  "Non-nil when BODY, a function's body, starts with an `interactive' form."
  (when (stringp (car body)) (setq body (cdr body)))
  (while (eq (car-safe (car body)) 'declare) (setq body (cdr body)))
  (eq (car-safe (car body)) 'interactive))

(defun harness-module-docs--hook-name-p (symbol)
  "Non-nil when SYMBOL names a hook: it ends in -hook or -functions."
  (string-match-p "-\\(?:hook\\|functions\\)\\'" (symbol-name symbol)))

(defun harness-module-docs--forwarded-variable-p (symbol)
  "Non-nil when SYMBOL is one of `harness-module-docs--forwarded-variables'."
  (memq symbol harness-module-docs--forwarded-variables))

(defun harness-module-docs--note (form env acc)
  "Note in ACC, a hash table, what FORM provides or uses.
ENV is as for `harness-module-docs--names'."
  (cl-flet ((add (key value) (push value (gethash key acc))))
    (pcase form
      (`(harness-define-module ,name . ,rest)
       (when-let* ((name (harness-module-docs--symbol name)))
         (unless (gethash :name acc)
           (puthash :name name acc)
           (let ((doc (plist-get rest :doc))
                 (requires (plist-get rest :requires)))
             (puthash :doc (and (stringp doc) doc) acc)
             (puthash :requires (and (eq (car-safe requires) 'quote) (listp (cadr requires))
                                     (cl-remove-if-not #'symbolp (cadr requires)))
                      acc)))))
      (`(harness-defmethod ,name ,args ,doc . ,_)
       (when (symbolp name)
         (add :methods (list name :args (and (listp args) args) :doc (and (stringp doc) doc)))))
      (`(harness-register-method ,name ,_ . ,keys)
       (when-let* ((name (harness-module-docs--symbol name)))
         (let ((doc (plist-get keys :doc)))
           (add :methods (list name :args nil :doc (and (stringp doc) doc))))))
      (`(harness-define-tool ,name . ,keys)
       (when (stringp name)
         (let ((description (plist-get keys :description)))
           (add :tools (cons name (and (stringp description) description))))))
      (`(harness-define-provider ,id . ,keys)
       (when-let* ((id (harness-module-docs--symbol id)))
         (let ((doc (plist-get keys :doc)))
           (add :providers (cons id (and (stringp doc) doc))))))
      (`(harness-declare-event ,name ,doc . ,_)
       (dolist (e (harness-module-docs--event-docs name doc env)) (add :events e)))
      (`(harness-emit ,event . ,_)
       (dolist (e (harness-module-docs--names event env)) (add :emits e)))
      (`(harness-on ,event ,fn . ,rest)
       (dolist (e (harness-module-docs--names event env))
         (add :handles (list e (harness-module-docs--fn fn) (and (numberp (car rest)) (car rest))))))
      (`(,(or 'harness-run-filter 'harness-run-filter-async 'harness-run-filter-async-between
              'harness-run-filter-async-traced)
         ,name . ,_)
       (dolist (n (harness-module-docs--names name env)) (add :filters-run n)))
      (`(harness-add-filter ,name ,fn . ,rest)
       (dolist (n (harness-module-docs--names name env))
         (add :filters-joined (list n (harness-module-docs--fn fn) (and (numberp (car rest)) (car rest))))))
      (`(,(or 'harness-call 'harness-call-async) ,method . ,_)
       (dolist (m (harness-module-docs--names method env)) (add :calls m)))
      (`(harness-method-exists-p ,method . ,_)
       (dolist (m (harness-module-docs--names method env)) (add :checks m)))
      (`(add-hook ,hook ,fn . ,_)
       (when-let* ((hook (harness-module-docs--symbol hook)))
         (add :hooks-used (list hook (harness-module-docs--fn fn)))))
      (`(add-to-list (quote ,(pred harness-module-docs--forwarded-variable-p)) ,event . ,_)
       (dolist (e (harness-module-docs--names event env)) (add :forwards e)))
      (`(,(or 'defvar 'defconst) ,(pred harness-module-docs--forwarded-variable-p)
         (quote ,(and events (pred listp))) . ,_)
       (dolist (e events) (when (symbolp e) (add :forwards e))))
      (`(,(and kind (or 'defvar 'defcustom 'defvar-local)) ,name . ,rest)
       (when (symbolp name)
         (let ((doc (and (stringp (nth 1 rest)) (nth 1 rest))))
           (cond ((harness-module-docs--hook-name-p name) (add :hooks-defined (cons name doc)))
                 ((eq kind 'defcustom) (add :options (cons name doc)))))))
      (`(,(or 'defun 'cl-defun) ,name ,_ . ,body)
       (when (symbolp name)
         (puthash name body (or (gethash :bodies acc) (puthash :bodies (make-hash-table :test 'eq) acc)))
         (when (and (not (string-search "--" (symbol-name name)))
                    (harness-module-docs--interactive-p body))
           (add :commands (cons name (and (stringp (car body)) (car body))))))))))

(defun harness-module-docs--event-strings (form)
  "Return the event names the strings in FORM spell.
That is AREA/VERB, or AREA/ for every event of AREA."
  (let ((found nil) (stack (list form)))
    (while stack
      (let ((x (pop stack)))
        (cond ((stringp x)
               (when (string-match-p "\\`[a-z][a-z0-9-]*/[a-z0-9-]*\\'" x)
                 (push x found)))
              ((consp x) (push (car x) stack) (push (cdr x) stack))
              ((vectorp x) (setq stack (append x stack))))))
    found))

(defun harness-module-docs--ui-events (acc)
  "Return (EVENT FN) for each event a function of ACC on the UI event hook names.
That is the functions the module adds to `harness-ui-event-functions'
and defines: an event is a string it compares the event with, as
\"agent/turn-ended\", or \"worktree/\" for the prefix, written worktree/*."
  (let ((bodies (gethash :bodies acc)))
    (cl-loop for (hook fn) in (gethash :hooks-used acc)
             when (and (eq hook harness-module-docs--ui-event-hook) (symbolp fn) bodies (gethash fn bodies))
             append (mapcar (lambda (s) (list (intern (if (string-suffix-p "/" s) (concat s "*") s)) fn))
                            (harness-module-docs--event-strings (gethash fn bodies))))))

(defun harness-module-docs--walk (form env acc)
  "Note in ACC what FORM and the forms inside it provide or use.
ENV maps the variable of each enclosing `dolist' over a quoted list to
that list, as (VAR . LIST) entries.  A string naming a harness method
over ACP (\"_harness/AREA/VERB\"), as UI modules call them, is a call."
  (cond
   ((stringp form)
    (when (string-match "\\`_harness/\\([a-z0-9-]+/[a-z0-9-]+\\)\\'" form)
      (push (intern (match-string 1 form)) (gethash :calls acc))))
   ((vectorp form)
    (mapc (lambda (x) (harness-module-docs--walk x env acc)) form))
   ((consp form)
    (harness-module-docs--note form env acc)
    (pcase form
      (`(dolist (,(and var (pred symbolp)) (quote ,(and list (pred listp)))) . ,_)
       (push (cons var list) env)))
    (while (consp form)
      (harness-module-docs--walk (car form) env acc)
      (setq form (cdr form)))
    (when form (harness-module-docs--walk form env acc)))))

(defun harness-module-docs--key (item)
  "Return the string ITEM sorts by: its name."
  (format "%s" (if (consp item) (car item) item)))

(defvar harness-module-docs--cache (make-hash-table :test 'equal)
  "File -> (MODIFICATION-TIME . SCAN).
A file is read again only once it changed.")

(defun harness-module-docs-scan (file)
  "Describe the module FILE defines, read from its source without loading it.
Return nil when FILE defines no module (a library such as
harness-ui-drag.el), else a plist:

  :name :file :doc :requires  from its `harness-define-module'
  :ui            non-nil for a UI module (ui or ui-NAME)
  :file-requires the harness files it requires at top level, as names
                 without the harness- prefix
  :commentary    its Commentary section, comment starters removed
  :methods       (NAME :args ARGS :doc DOC) it defines
  :tools         (NAME . DESCRIPTION) of the tools it defines
  :providers     (ID . DOC) of the model providers it defines by name
  :events        (NAME . DOC) it declares
  :emits         events it emits
  :handles       (EVENT FN PRIORITY) it subscribes
  :ui-events     (EVENT FN) a UI module hears over ACP, through
                 `harness-ui-event-functions'; EVENT AREA/* is a prefix
  :forwards      events it has the ACP server forward to the UI
  :filters-run   filter chains it runs
  :filters-joined (CHAIN FN PRIORITY) it joins
  :calls         methods it calls, on the bus or over ACP
  :checks        methods it checks for with `harness-method-exists-p'
  :hooks-defined (HOOK . DOC) of the -hook and -functions it defines
  :hooks-used    (HOOK FN) it adds to
  :options       (OPTION . DOC) of its other user options
  :commands      (COMMAND . DOC) of its interactive public functions

FN is a function's symbol, or \"lambda\"; PRIORITY nil means 50.  Each
list is sorted by name.  A file that cannot be read gives (:file FILE
:error MESSAGE)."
  (let* ((file (expand-file-name file))
         (mtime (file-attribute-modification-time (file-attributes file)))
         (cached (gethash file harness-module-docs--cache)))
    (if (and cached (equal (car cached) mtime))
        (cdr cached)
      (let ((scan (harness-module-docs--scan-1 file)))
        (puthash file (cons mtime scan) harness-module-docs--cache)
        scan))))

(defun harness-module-docs--read (file)
  "Return what FILE provides and uses, as a plist of the lists of a scan.
See `harness-module-docs-scan'; the module's own keys are left out, but
:name, which is nil when FILE defines no module."
  (let ((acc (make-hash-table :test 'eq)))
    (dolist (form (harness-module-docs--forms file))
      (pcase form
        (`(require (quote ,(and feature (pred symbolp))) . ,_)
         (let ((name (symbol-name feature)))
           (when (string-prefix-p "harness-" name)
             (push (intern (string-remove-prefix "harness-" name)) (gethash :file-requires acc)))))
        (_ (harness-module-docs--walk form nil acc))))
    (puthash :ui-events (harness-module-docs--ui-events acc) acc)
    (append (list :name (gethash :name acc) :doc (gethash :doc acc) :requires (gethash :requires acc))
            (cl-loop for key in harness-module-docs--lists
                     append (list key (sort (delete-dups (gethash key acc))
                                            (lambda (a b) (string< (harness-module-docs--key a)
                                                                   (harness-module-docs--key b)))))))))

(defun harness-module-docs--scan-1 (file)
  "Read FILE as `harness-module-docs-scan' describes."
  (condition-case err
      (let ((read (harness-module-docs--read file)))
        (when-let* ((name (plist-get read :name)))
          (append (list :name name :file file :doc (plist-get read :doc)
                        :requires (plist-get read :requires)
                        :ui (and (string-match-p "\\`ui\\(?:-\\|\\'\\)" (symbol-name name)) t)
                        :commentary (harness-module-docs--commentary file))
                  (cl-loop for key in harness-module-docs--lists
                           append (list key (plist-get read key))))))
    (error (list :file file :error (error-message-string err)))))

(defvar harness--core-files)
(defvar harness--library-files)

(defun harness-module-docs-core-files ()
  "Return the files of the harness that are no module.
They are harness.el, the core files and the libraries."
  (cons (expand-file-name "harness.el" harness-directory)
        (mapcar (lambda (f) (expand-file-name f harness-directory))
                (append (bound-and-true-p harness--core-files)
                        (bound-and-true-p harness--library-files)))))

(defun harness-module-docs-core-scans ()
  "Return what the harness's files that are no module provide and use.
A scan for each of `harness-module-docs-core-files', as
`harness-module-docs-scan' makes, named by the file: harness.el emits
the harness/started event, for instance.  They have no page."
  (cl-loop for file in (harness-module-docs-core-files)
           when (file-exists-p file)
           collect (let* ((mtime (file-attribute-modification-time (file-attributes file)))
                          (key (cons 'core file))
                          (cached (gethash key harness-module-docs--cache))
                          (read (if (and cached (equal (car cached) mtime))
                                    (cdr cached)
                                  (let ((r (condition-case nil (harness-module-docs--read file) (error nil))))
                                    (puthash key (cons mtime r) harness-module-docs--cache)
                                    r))))
                     (append (list :name (intern (file-name-nondirectory file)) :file file :core t)
                             (cl-loop for k in harness-module-docs--lists
                                      append (list k (plist-get read k)))))))

;;;; All the modules, linked

(defun harness-module-docs-files ()
  "Return the module files the harness can load, its own then the user's.
Its own are those of lisp/modules, lisp/ui and `harness-module-directories'
under `harness-directory', the user's those of
`harness-extra-module-directories'."
  (let ((dirs (append (mapcar (lambda (d) (expand-file-name d harness-directory))
                              (delete-dups (append (list "lisp/modules" "lisp/ui")
                                                   (bound-and-true-p harness-module-directories))))
                      (and (fboundp 'harness--extra-module-directories)
                           (harness--extra-module-directories)))))
    (cl-loop for dir in dirs
             when (file-directory-p dir)
             append (directory-files dir t "\\`harness-[a-z0-9-]+\\.el\\'"))))

(defun harness-module-docs-collect (&optional files)
  "Return the scans of the modules of FILES, sorted by name, linked together.
FILES defaults to `harness-module-docs-files'.  Of two modules of one
name the first is kept, as the loader keeps it.  Each scan (see
`harness-module-docs-scan') has two more keys: :required-by, the modules
that require it, and :owners, an alist from each method it calls or
checks for to the module that defines it, when one of FILES does, or
the file of the harness's core that does."
  (let* ((scans (cl-remove-if (lambda (s) (or (null s) (plist-get s :error)))
                              (mapcar #'harness-module-docs-scan (or files (harness-module-docs-files)))))
         (scans (cl-remove-duplicates scans :key (lambda (s) (plist-get s :name)) :from-end t))
         (scans (sort scans (lambda (a b) (string< (plist-get a :name) (plist-get b :name)))))
         (owners (make-hash-table :test 'eq)))
    (dolist (s (append scans (harness-module-docs-core-scans)))
      (dolist (m (plist-get s :methods))
        (unless (gethash (car m) owners) (puthash (car m) (plist-get s :name) owners))))
    (mapcar (lambda (s)
              (let ((name (plist-get s :name)))
                (append s (list :required-by
                                (cl-loop for o in scans
                                         when (memq name (plist-get o :requires))
                                         collect (plist-get o :name))
                                :owners
                                (cl-loop for m in (delete-dups (append (plist-get s :calls)
                                                                       (copy-sequence (plist-get s :checks))))
                                         for owner = (gethash m owners)
                                         when owner collect (cons m owner))))))
            scans)))

;;;; Markdown

(defun harness-module-docs--md (text)
  "Return TEXT, Lisp documentation, as Markdown: `this' quoting becomes `this`."
  (replace-regexp-in-string "`\\([^`'\n]+\\)'" "`\\1`" (or text "") t))

(defun harness-module-docs--line (doc)
  "Return the first line of DOC as Markdown, or nil."
  (when (and (stringp doc) (not (string-empty-p doc)))
    (harness-module-docs--md (car (split-string doc "\n")))))

(defun harness-module-docs--cell (text)
  "Return TEXT made safe for a Markdown table cell."
  (replace-regexp-in-string "|" "\\\\|" (replace-regexp-in-string "\n" " " (or text "")) t t))

(defun harness-module-docs--link (name &optional all)
  "Return a link to module NAME's page, or NAME in code when ALL lacks it."
  (if (or (null all) (cl-find name all :key (lambda (s) (plist-get s :name))))
      (format "[%s](%s.md)" name name)
    (format "`%s`" name)))

(defun harness-module-docs--links (names all)
  "Return links to the pages of NAMES in ALL, joined, or nil when there is none."
  (when names
    (mapconcat (lambda (n) (harness-module-docs--link n all)) names ", ")))

(defun harness-module-docs--side (scan)
  "Say where the module of SCAN runs."
  (if (plist-get scan :ui) "the UI (your Emacs)" "the harness process"))

(defun harness-module-docs--loaded (name)
  "Say whether module NAME loads by default, or nil when that is not known."
  (when (fboundp 'harness-module-default-p)
    (if (harness-module-default-p name)
        "by default"
      "when enabled (see `harness-enable-modules`)")))

(defun harness-module-docs--source (file dir)
  "Return FILE as a Markdown link relative to DIR, or as a path.
A file outside `harness-directory', a module of the user's own, is
named by its path."
  (if (and (bound-and-true-p harness-directory)
           (string-prefix-p (file-name-as-directory (expand-file-name harness-directory)) file))
      (format "[%s](%s)" (file-relative-name file harness-directory)
              (if dir (file-relative-name file dir) (file-relative-name file harness-directory)))
    (format "`%s`" (abbreviate-file-name file))))

(defun harness-module-docs--priority (p)
  "Return \" at P\" for a priority P other than the default, else \"\"."
  (if (and p (/= p 50)) (format " at %s" p) ""))

(defun harness-module-docs--section (title items render)
  "Return a Markdown subsection TITLE listing ITEMS with RENDER, or \"\"."
  (if (null items)
      ""
    (concat "### " title "\n\n"
            (mapconcat (lambda (i) (concat "- " (funcall render i))) items "\n")
            "\n\n")))

(defun harness-module-docs--described (name doc)
  "Return `NAME`, with the first line of DOC after a dash when there is one."
  (let ((line (harness-module-docs--line doc)))
    (if line (format "`%s` — %s" name line) (format "`%s`" name))))

(defun harness-module-docs-brings-along (scan all)
  "Return what the module of SCAN loads besides what it requires, among ALL.
That is ((NAME . WHY) ...): its other half, ui-NAME for NAME and NAME
for ui-NAME, and the modules whose files it requires without naming
them in its :requires, which load with it all the same (see
`harness-enabled-modules')."
  (let* ((name (plist-get scan :name))
         (names (mapcar (lambda (s) (plist-get s :name)) all))
         (half (let ((n (symbol-name name)))
                 (cond ((eq name 'ui) nil)
                       ((string-prefix-p "ui-" n) (intern (substring n 3)))
                       (t (intern (concat "ui-" n)))))))
    (append (and half (memq half names)
                 (list (cons half (if (plist-get scan :ui) "the rest of it" "its UI"))))
            (cl-loop for r in (plist-get scan :file-requires)
                     when (and (memq r names) (not (eq r name)) (not (eq r half))
                               (not (memq r (plist-get scan :requires))))
                     collect (cons r "its file requires it")))))

(defun harness-module-docs-page (scan all &optional dir)
  "Return the Markdown page of the module SCAN describes.
ALL is every scan, from `harness-module-docs-collect', for the links;
DIR is the directory the page goes in, for the link to the source."
  (let* ((name (plist-get scan :name))
         (owners (plist-get scan :owners))
         (loaded (harness-module-docs--loaded name))
         (facts (delq nil (list (concat "**Runs in:** " (harness-module-docs--side scan))
                                (concat "**Source:** " (harness-module-docs--source (plist-get scan :file) dir))
                                (and loaded (concat "**Loaded:** " loaded))
                                (concat "**Requires:** " (or (harness-module-docs--links (plist-get scan :requires) all)
                                                             "nothing"))
                                (and (plist-get scan :required-by)
                                     (concat "**Required by:** "
                                             (harness-module-docs--links (plist-get scan :required-by) all)))
                                (when-let* ((along (harness-module-docs-brings-along scan all)))
                                  (concat "**Brings along:** "
                                          (mapconcat (lambda (b)
                                                       (concat (harness-module-docs--link (car b) all)
                                                               (format " (%s)" (cdr b))))
                                                     along ", "))))))
         (provides (concat
                    (harness-module-docs--section
                     "Methods" (plist-get scan :methods)
                     (lambda (m) (let ((line (harness-module-docs--line (plist-get (cdr m) :doc)))
                                       (args (plist-get (cdr m) :args)))
                                   (concat (format "`%s`" (car m))
                                           (if args (format " %s" (harness-module-docs--md (format "%s" args))) "")
                                           (if line (concat " — " line) "")))))
                    (harness-module-docs--section
                     "Tools" (plist-get scan :tools)
                     (lambda (e) (harness-module-docs--described (car e) (cdr e))))
                    (harness-module-docs--section
                     "Model providers" (plist-get scan :providers)
                     (lambda (e) (harness-module-docs--described (car e) (cdr e))))
                    (harness-module-docs--section
                     "Events" (plist-get scan :events)
                     (lambda (e) (harness-module-docs--described (car e) (cdr e))))
                    (harness-module-docs--section
                     "Filter chains it runs" (plist-get scan :filters-run)
                     (lambda (f) (format "`%s`" f)))
                    (harness-module-docs--section
                     "Hooks" (plist-get scan :hooks-defined)
                     (lambda (e) (harness-module-docs--described (car e) (cdr e))))
                    (harness-module-docs--section
                     "Commands" (plist-get scan :commands)
                     (lambda (e) (harness-module-docs--described (car e) (cdr e))))
                    (harness-module-docs--section
                     "Options" (plist-get scan :options)
                     (lambda (e) (harness-module-docs--described (car e) (cdr e))))))
         (uses (concat
                (harness-module-docs--section
                 "Methods it calls"
                 (cl-remove-if (lambda (m) (eq (alist-get m owners) name))
                               (sort (delete-dups (append (plist-get scan :calls)
                                                          (copy-sequence (plist-get scan :checks))))
                                     (lambda (a b) (string< (symbol-name a) (symbol-name b)))))
                 (lambda (m) (let ((owner (alist-get m owners)))
                               (concat (format "`%s`" m)
                                       (if owner (format " (%s)" (harness-module-docs--link owner all)) "")
                                       ;; Checked for, as a method of a module it does
                                       ;; not require: it does without.
                                       (if (and (memq m (plist-get scan :checks))
                                                (not (memq owner (plist-get scan :requires))))
                                           ", when it is loaded"
                                         "")))))
                (harness-module-docs--section
                 "Events it handles" (plist-get scan :handles)
                 (lambda (h) (format "`%s` → `%s`%s" (nth 0 h) (nth 1 h)
                                     (harness-module-docs--priority (nth 2 h)))))
                (harness-module-docs--section
                 "Events it hears over ACP" (plist-get scan :ui-events)
                 (lambda (h) (format "`%s` → `%s`%s" (nth 0 h) (nth 1 h)
                                     (if (harness-module-docs-reaches-ui-p all (nth 0 h))
                                         ""
                                       " (never forwarded to the UI)"))))
                (harness-module-docs--section
                 "Events it emits" (plist-get scan :emits)
                 (lambda (e) (format "`%s`" e)))
                (harness-module-docs--section
                 "Filter chains it joins" (plist-get scan :filters-joined)
                 (lambda (f) (format "`%s`%s → `%s`" (nth 0 f) (harness-module-docs--priority (nth 2 f))
                                     (nth 1 f))))
                (harness-module-docs--section
                 "Hooks it adds to" (plist-get scan :hooks-used)
                 (lambda (h) (format "`%s` → `%s`" (nth 0 h) (nth 1 h)))))))
    (concat harness-module-docs-header "\n\n"
            "# " (symbol-name name) "\n\n"
            (if (plist-get scan :doc) (concat (harness-module-docs--md (plist-get scan :doc)) "\n\n") "")
            (mapconcat (lambda (f) (concat "- " f)) facts "\n") "\n\n"
            (if (plist-get scan :commentary)
                (concat "## About\n\n" (harness-module-docs--md (plist-get scan :commentary)) "\n\n")
              "")
            (if (string-empty-p provides) "" (concat "## Provides\n\n" provides))
            (if (string-empty-p uses) "" (concat "## Uses\n\n" uses)))))

(defun harness-module-docs--table (header rows)
  "Return a Markdown table with HEADER, a list of strings, and ROWS of cells."
  (concat "| " (string-join header " | ") " |\n"
          "|" (mapconcat (lambda (_) "---") header "|") "|\n"
          (mapconcat (lambda (row)
                       (concat "| " (mapconcat #'harness-module-docs--cell row " | ") " |"))
                     rows "\n")
          "\n\n"))

(defun harness-module-docs--who (all key name &optional pool)
  "Return the modules whose list KEY has NAME, linked to their pages in ALL.
They are searched for among POOL, default ALL; one that has no page in
ALL, a file of the harness's core, is named in code.  Return \"\" when
there is none.  An entry of a list KEY that is a list matches by its car."
  (or (harness-module-docs--links
       (cl-loop for s in (or pool all)
                when (cl-some (lambda (e) (eq name (if (consp e) (car e) e)))
                              (plist-get s key))
                collect (plist-get s :name))
       all)
      ""))

(defun harness-module-docs--joined (all key name &optional pool)
  "Return the modules joining chain or hook NAME through KEY, linked.
They are linked to their pages in ALL as `harness-module-docs--who'
links them, and searched for among POOL, default ALL.  For filter chains, each
comes with the priorities it joins at."
  (string-join
   (cl-loop for s in (or pool all)
            for entries = (cl-remove-if-not (lambda (e) (eq (car e) name)) (plist-get s key))
            when entries
            collect (let ((ps (delete-dups (delq nil (mapcar (lambda (e) (nth 2 e)) entries)))))
                      (concat (harness-module-docs--link (plist-get s :name) all)
                              (if (and (eq key :filters-joined) entries)
                                  (format " (%s)" (mapconcat (lambda (p) (format "%s" p))
                                                             (sort (or ps (list 50)) #'<) ", "))
                                ""))))
   ", "))

(defun harness-module-docs--names-of (all &rest keys)
  "Return the sorted names the lists KEYS of ALL's scans hold.
Event prefixes, AREA/*, are left out."
  (sort (delete-dups (cl-loop for s in all
                              append (cl-loop for k in keys
                                              append (cl-loop for e in (plist-get s k)
                                                              for n = (if (consp e) (car e) e)
                                                              unless (string-suffix-p "/*" (symbol-name n))
                                                              collect n))))
        (lambda (a b) (string< (symbol-name a) (symbol-name b)))))

(defun harness-module-docs--event-match-p (pattern event)
  "Non-nil when PATTERN, an event or an AREA/* prefix, matches EVENT."
  (let ((p (symbol-name pattern)))
    (if (string-suffix-p "/*" p)
        (string-prefix-p (substring p 0 -1) (symbol-name event))
      (eq pattern event))))

(defun harness-module-docs-hearers (all event)
  "Return the names of the modules among ALL that handle EVENT.
On the bus, or over ACP in the UI: by its name, or, when it is
forwarded to the UI, by a prefix of it."
  (let ((forwarded (harness-module-docs-forwarded-p all event)))
    (cl-loop for s in all
             when (or (assq event (plist-get s :handles))
                      (cl-some (lambda (h) (or (eq (car h) event)
                                               (and forwarded
                                                    (harness-module-docs--event-match-p (car h) event))))
                               (plist-get s :ui-events)))
             collect (plist-get s :name))))

(defun harness-module-docs-forwarded-p (all event)
  "Non-nil when a module among ALL has the ACP server forward EVENT to the UI."
  (cl-some (lambda (s) (memq event (plist-get s :forwards))) all))

(defun harness-module-docs-reaches-ui-p (all pattern)
  "Non-nil when an event PATTERN matches reaches the UI, as ALL forward them.
PATTERN is an event or an AREA/* prefix (see `harness-module-docs-scan')."
  (cl-some (lambda (s) (cl-some (lambda (e) (harness-module-docs--event-match-p pattern e))
                                (plist-get s :forwards)))
           all))

(defun harness-module-docs--short (doc width)
  "Return the first line of DOC, cut at a word to WIDTH characters at most."
  (let ((line (or (harness-module-docs--line doc) "")))
    (if (<= (length line) width)
        line
      (let ((cut (substring line 0 (1- width))))
        (concat (if (string-match "\\`\\(.*[^ ]\\) [^ ]*\\'" cut) (match-string 1 cut) cut) "…")))))

(declare-function harness--module-closure "harness" (sources names))
(declare-function harness--module-sources "harness" (&optional warn))

(defun harness-module-docs--needs (scan all)
  "Return the harness modules the UI module of SCAN needs, if enabled.
ALL is every module's scan.  Those are the modules that do not load by
default and own methods it calls without checking for them first, and
that enabling it does not bring along (`harness--module-closure')."
  (let ((along (if (fboundp 'harness--module-closure)
                   (harness--module-closure (harness--module-sources) (list (plist-get scan :name)))
                 (list (intern (string-remove-prefix "ui-" (symbol-name (plist-get scan :name))))))))
    (sort (delete-dups
           (cl-loop for (method . owner) in (plist-get scan :owners)
                    when (and (not (memq method (plist-get scan :checks)))
                              (not (memq owner along))
                              (cl-find owner all :key (lambda (s) (plist-get s :name)))
                              (not (plist-get (cl-find owner all :key (lambda (s) (plist-get s :name))) :ui))
                              (not (and (fboundp 'harness-module-default-p) (harness-module-default-p owner))))
                    collect owner))
          (lambda (a b) (string< (symbol-name a) (symbol-name b))))))

(defun harness-module-docs-template (all)
  "Return a `harness-enable-modules' form for an init file, as Doom's init.el has.
It names, commented out, every module among ALL that does not load by
default and that another does not bring along as its other half, in
the groups of `harness-enable-modules', each with what it is."
  (let* ((names (mapcar (lambda (s) (plist-get s :name)) all))
         (candidates
          (cl-remove-if
           (lambda (s)
             (let ((name (plist-get s :name)))
               (or (and (fboundp 'harness-module-default-p) (harness-module-default-p name))
                   ;; ui-tasks comes with tasks.
                   (and (plist-get s :ui)
                        (memq (intern (string-remove-prefix "ui-" (symbol-name name))) names)))))
           all)))
    (concat
     "(harness-enable-modules\n"
     (mapconcat
      (lambda (group)
        (let ((rows (cl-loop for s in candidates
                             for name = (symbol-name (plist-get s :name))
                             for in = (cl-find-if (lambda (g) (and (not (string-empty-p (cdr g)))
                                                                   (string-prefix-p (cdr g) name)))
                                                  harness--module-groups)
                             when (eq (car (or in (car harness--module-groups))) (car group))
                             collect (let* ((short (string-remove-prefix (cdr group) name))
                                            (needs (and (plist-get s :ui) (harness-module-docs--needs s all)))
                                            (note (if needs
                                                      (format " (with %s)" (mapconcat #'symbol-name needs " "))
                                                    "")))
                                       (format " ;;%-18s ; %s%s" short
                                               (harness-module-docs--short (plist-get s :doc)
                                                                           (- 72 (length note)))
                                               note)))))
          (when rows
            (concat " " (symbol-name (car group)) "\n" (string-join rows "\n") "\n"))))
      harness--module-groups "")
     " )\n")))

(defun harness-module-docs-index (all)
  "Return the Markdown index of ALL, scans from `harness-module-docs-collect'."
  (let ((everything (append all (harness-module-docs-core-scans)))
        (modules (lambda (ui)
                   (harness-module-docs--table
                    (if (fboundp 'harness-module-default-p)
                        '("Module" "Loaded" "Requires" "What it is")
                      '("Module" "Requires" "What it is"))
                    (cl-loop for s in all
                             when (eq (and (plist-get s :ui) t) ui)
                             collect (let ((name (plist-get s :name)))
                                       (append (list (harness-module-docs--link name all))
                                               (and (fboundp 'harness-module-default-p)
                                                    (list (if (harness-module-default-p name) "by default" "")))
                                               (list (or (harness-module-docs--links (plist-get s :requires) all) "")
                                                     (or (harness-module-docs--line (plist-get s :doc)) "")))))))))
    (concat
     harness-module-docs-header "\n\n"
     "# Modules\n\n"
     "Every feature of the harness is a module. Each page here is read from the\n"
     "module's source (see `lisp/harness-module-docs.el`): what it provides to\n"
     "the others and what it uses of them. `scripts/module-docs.sh` writes them\n"
     "again; `M-x harness-describe-module` shows one in Emacs.\n\n"
     (if (fboundp 'harness-module-default-p)
         (concat
          "## Choosing modules\n\n"
          "The modules marked *by default* below always load: the core\n"
          "(`harness-core-modules`) and what comes with it. The others load when\n"
          "your init file enables them, after `(require 'harness)`: copy this,\n"
          "uncomment the modules you want, and restart the harness. A module\n"
          "brings along what it requires and its UI (tasks loads the task board,\n"
          "ui-tasks); `(setq harness-enabled-modules t)` loads every module.\n\n"
          "```elisp\n" (harness-module-docs-template all) "```\n\n")
       "")
     "## The harness process\n\n" (funcall modules nil)
     "## The UI\n\n" (funcall modules t)
     "## Events\n\n"
     "An event reaches the UI modules when the ACP server forwards it (the\n"
     "column \"To the UI\"); they hear it through `harness-ui-event-functions`.\n\n"
     (harness-module-docs--table
      '("Event" "Declared by" "Emitted by" "Handled by" "To the UI")
      (mapcar (lambda (e)
                (list (format "`%s`" e)
                      (harness-module-docs--who all :events e everything)
                      (harness-module-docs--who all :emits e everything)
                      (or (harness-module-docs--links (harness-module-docs-hearers everything e) all) "")
                      (if (harness-module-docs-forwarded-p everything e) "yes" "")))
              (harness-module-docs--names-of everything :events :emits :handles :ui-events :forwards)))
     "## Filter chains\n\n"
     (harness-module-docs--table
      '("Chain" "Run by" "Joined by (priorities)")
      (mapcar (lambda (f)
                (list (format "`%s`" f)
                      (harness-module-docs--who all :filters-run f everything)
                      (harness-module-docs--joined all :filters-joined f everything)))
              (harness-module-docs--names-of everything :filters-run :filters-joined)))
     "## Hooks\n\n"
     (harness-module-docs--table
      '("Hook" "Defined by" "Added to by")
      (mapcar (lambda (h)
                (list (format "`%s`" h)
                      (harness-module-docs--who all :hooks-defined h everything)
                      (harness-module-docs--joined all :hooks-used h everything)))
              (harness-module-docs--names-of everything :hooks-defined :hooks-used))))))

(defun harness-module-docs--generated-p (file)
  "Non-nil when FILE starts with `harness-module-docs-header'."
  (with-temp-buffer
    (insert-file-contents file nil 0 (length harness-module-docs-header))
    (equal (buffer-string) harness-module-docs-header)))

(defun harness-module-docs--write (file text)
  "Write TEXT to FILE unless FILE holds it already."
  (unless (and (file-exists-p file)
               (with-temp-buffer
                 (insert-file-contents file)
                 (equal (buffer-string) text)))
    (let ((coding-system-for-write 'utf-8-unix))
      (write-region text nil file nil 'silent))))

(defun harness-module-docs-generate (dir &optional as)
  "Write a page for each module the harness can load into DIR, and an index.
Pages are NAME.md, the index README.md.  A page DIR has from a module
that is gone is deleted; a file of DIR that is no generated page is
left alone.  The links to the modules' source are relative to AS,
default DIR, where the pages are read: a check writes them elsewhere to
compare them with those there.  Return the files written."
  (let* ((dir (file-name-as-directory (expand-file-name dir)))
         (as (if as (file-name-as-directory (expand-file-name as)) dir))
         (all (harness-module-docs-collect))
         (written nil))
    (make-directory dir t)
    (dolist (scan all)
      (let ((file (expand-file-name (format "%s.md" (plist-get scan :name)) dir)))
        (harness-module-docs--write file (harness-module-docs-page scan all as))
        (push file written)))
    (let ((index (expand-file-name "README.md" dir)))
      (harness-module-docs--write index (harness-module-docs-index all))
      (push index written))
    (dolist (file (directory-files dir t "\\.md\\'"))
      (unless (or (member file written) (not (harness-module-docs--generated-p file)))
        (delete-file file)))
    (nreverse written)))

;;;; In Emacs

(declare-function harness-ui-markdown-render "harness-ui-markdown" (text))

(defvar harness-module-docs-link-map
  (let ((map (make-sparse-keymap)))
    (define-key map [mouse-2] #'harness-module-docs-follow-link)
    (define-key map [follow-link] 'mouse-face)
    (define-key map (kbd "RET") #'harness-module-docs-follow-link)
    map)
  "Keymap of a link to another module in `harness-describe-module'.")

(defun harness-module-docs-follow-link (&optional event)
  "Describe the module whose link is at point, or the one mouse EVENT clicked."
  (interactive (list last-nonmenu-event))
  (let* ((posn (and (mouse-event-p event) (event-start event)))
         (name (get-text-property (or (and posn (posn-point posn)) (point)) 'harness-module)))
    (unless name (user-error "No module link here"))
    (harness-describe-module name)))

(defun harness-module-docs--render (page)
  "Return PAGE, a module's Markdown page, as `harness-describe-module' shows it.
Its first line, the comment generated pages start with, is left out.
With the UI's Markdown renderer loaded, the page is rendered, and a
link to another module's page describes that module; else it stays
Markdown."
  (let ((text (string-trim-left (string-remove-prefix harness-module-docs-header page))))
    (if (not (fboundp 'harness-ui-markdown-render))
        text
      (let ((s (harness-ui-markdown-render text))
            (pos 0))
        (while (setq pos (text-property-not-all pos (length s) 'harness-url nil s))
          (let ((end (or (next-single-property-change pos 'harness-url s) (length s)))
                (url (get-text-property pos 'harness-url s)))
            (when (string-match "\\`\\([a-z0-9-]+\\)\\.md\\'" url)
              (add-text-properties pos end
                                   (list 'harness-module (intern (match-string 1 url))
                                         'keymap harness-module-docs-link-map
                                         'help-echo (concat "Describe module " (match-string 1 url)))
                                   s))
            (setq pos end)))
        s))))

;;;###autoload
(defun harness-describe-module (name)
  "Describe module NAME: what it provides to the others, and what it uses.
It is read from the module's source, the harness's own or one of
`harness-extra-module-directories', loaded or not; the page is the
one scripts/module-docs.sh writes for it."
  (interactive
   (let ((names (mapcar (lambda (s) (symbol-name (plist-get s :name))) (harness-module-docs-collect))))
     (list (intern (completing-read "Describe module: " names nil t)))))
  (let* ((all (harness-module-docs-collect))
         (scan (cl-find name all :key (lambda (s) (plist-get s :name)))))
    (unless scan (user-error "No module %s" name))
    (with-help-window (format "*harness-module %s*" name)
      (with-current-buffer standard-output
        ;; Where the link to the source leads from.
        (setq default-directory (file-name-as-directory harness-directory))
        (insert (harness-module-docs--render (harness-module-docs-page scan all)))))))

(provide 'harness-module-docs)
